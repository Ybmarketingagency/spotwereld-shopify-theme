{%- comment -%}
  FAQPage JSON-LD. LET OP: deze vragen/antwoorden moeten woordelijk overeenkomen met de
  zichtbare accordeon hieronder — Google vereist dat schema en pagina-inhoud identiek zijn.
  Wijzig je een antwoord in de HTML, pas het hier dan ook aan.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Hoe kan ik een bestelling plaatsen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Kies je product, voeg het toe aan je winkelwagen en ga naar de kassa. Je kunt betalen met iDEAL, creditcard, Klarna of andere methoden. Je ontvangt na betaling een bevestigingsmail." }
    },
    {
      "@type": "Question",
      "name": "Kan ik mijn bestelling annuleren of wijzigen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Neem zo snel mogelijk contact op via info@spotwereld.nl of (0)85 333 26 72. Bestellingen die al in verwerking zijn kunnen niet meer worden aangepast." }
    },
    {
      "@type": "Question",
      "name": "Welke betaalmethoden accepteren jullie?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wij accepteren iDEAL, Visa, Mastercard, Klarna (achteraf betalen), PayPal en Bancontact. Alle betalingen worden beveiligd verwerkt." }
    },
    {
      "@type": "Question",
      "name": "Hoe lang duurt de bezorging?",
      "acceptedAnswer": { "@type": "Answer", "text": "Vandaag besteld, morgen verzonden. We werken samen met PostNL en DHL voor snelle en betrouwbare bezorging door heel Nederland." }
    },
    {
      "@type": "Question",
      "name": "Zijn de verzendkosten gratis?",
      "acceptedAnswer": { "@type": "Answer", "text": "Gratis verzending bij bestellingen van €50 of meer. Onder de €25 rekenen we €4,95, tussen €25 en €50 is het €7,95 voor standaard bezorging." }
    },
    {
      "@type": "Question",
      "name": "Kan ik mijn bestelling volgen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Zodra je bestelling is verzonden ontvang je een track & trace link per e-mail. Je kunt hiermee de status van je pakket realtime volgen." }
    },
    {
      "@type": "Question",
      "name": "Hoeveel garantie krijg ik op mijn product?",
      "acceptedAnswer": { "@type": "Answer", "text": "Alle Spotwereld producten hebben standaard 5 jaar garantie. Dit dekt fabricagefouten en materiaaldefecten. Schade door verkeerd gebruik valt niet onder de garantie." }
    },
    {
      "@type": "Question",
      "name": "Zijn de LED spots dimbaar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dit verschilt per product. In de productbeschrijving staat duidelijk vermeld of een spot dimbaar is. Let bij dimbare spots op compatibiliteit met je dimmer." }
    },
    {
      "@type": "Question",
      "name": "Wat is het verschil tussen warm wit en koud wit?",
      "acceptedAnswer": { "@type": "Answer", "text": "Warm wit (2700–3000K) geeft een gezellig, sfeervol licht — ideaal voor woonkamers. Koud wit (4000–6500K) geeft helder, fris licht — perfect voor keukens en badkamers. Neutraal wit (3500K) zit er tussenin." }
    },
    {
      "@type": "Question",
      "name": "Hoe retourneer ik een product?",
      "acceptedAnswer": { "@type": "Answer", "text": "{{ 'sw.faq.a10' | t }}" }
    },
    {
      "@type": "Question",
      "name": "Wanneer ontvang ik mijn geld terug?",
      "acceptedAnswer": { "@type": "Answer", "text": "Na ontvangst en controle van je retour storten we het bedrag binnen 5 werkdagen terug op je rekening of creditcard." }
    }
  ]
}
</script>

<style>
.sw-ks-wrap{max-width:1280px;margin:0 auto;padding:3rem 1.5rem 5rem;display:grid;grid-template-columns:1fr;gap:2.5rem}
@media(min-width:768px){.sw-ks-wrap{grid-template-columns:220px 1fr}}
.sw-ks-sidebar{align-self:start}@media(min-width:768px){.sw-ks-sidebar{position:sticky;top:7rem}}
.sw-ks-sidebar h3{font-size:.75rem;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .75rem;padding:0 .75rem}
.sw-ks-sidebar nav{display:flex;flex-direction:column;gap:.125rem}
.sw-ks-sidebar a{display:block;padding:.5rem .75rem;border-radius:.5rem;color:#374151;font-size:.9375rem;text-decoration:none;font-weight:500;transition:background .15s,color .15s;line-height:1.4}
.sw-ks-sidebar a:hover{background:#EBF2FF;color:#0F6FE3}
.sw-ks-sidebar a.sw-active{background:#EBF2FF;color:#083D7D;font-weight:700;border-left:3px solid #0F6FE3;padding-left:calc(.75rem - 3px)}
.sw-faq-item{border-bottom:1px solid #e5e7eb;overflow:hidden}
.sw-faq-btn{width:100%;background:none;border:none;padding:1.25rem 1rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer;text-align:left;gap:1rem}
.sw-faq-btn:hover{background:#f9fafb}
.sw-faq-q{font-weight:600;color:#111827;font-size:1rem}
.sw-faq-icon{width:1.5rem;height:1.5rem;border-radius:50%;background:#EBF2FF;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .2s}
.sw-faq-answer{max-height:0;overflow:hidden;transition:max-height .3s ease,padding .3s ease}
.sw-faq-answer.open{max-height:500px}
.sw-faq-answer-inner{padding:.25rem 1rem 1.25rem;color:#6b7280;font-size:.9375rem;line-height:1.7}
</style>

