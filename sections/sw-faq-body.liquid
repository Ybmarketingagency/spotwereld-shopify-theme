{%- assign sw_root = routes.root_url | append: '/' | replace: '//', '/' | remove_last: '/' -%}
{%- comment -%}
  De vragen komen uit Content > Pagina's > Veelgestelde Vragen. Structuur:
  <h2> is een categorie, <h3> een vraag, de HTML daaronder het antwoord.
  Voeg je in de admin een <h2> of <h3> toe, dan verschijnt hij hier vanzelf.
{%- endcomment -%}
{%- assign sw_cats = page.content | split: '<h2>' -%}

{%- comment -%}
  FAQPage-markup uit dezelfde bron als de accordeon, zodat schema en pagina niet meer
  uit elkaar kunnen lopen. Google eist dat ze woordelijk overeenkomen.
{%- endcomment -%}
{%- capture sw_faq_json -%}
  {%- assign sw_eerste = true -%}
  {%- for sw_c in sw_cats offset: 1 -%}
    {%- assign sw_na_h2 = sw_c | split: '</h2>' | last -%}
    {%- assign sw_qs = sw_na_h2 | split: '<h3>' -%}
    {%- for sw_v in sw_qs offset: 1 -%}
      {%- assign sw_q = sw_v | split: '</h3>' | first | strip_html | strip -%}
      {%- assign sw_a = sw_v | split: '</h3>' | last | strip_html | strip -%}
      {%- if sw_q != blank and sw_a != blank -%}
        {%- unless sw_eerste %},{% endunless -%}
        {%- assign sw_eerste = false -%}
        {"@type":"Question","name":{{ sw_q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ sw_a | json }}}}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign sw_faq_json = sw_faq_json | strip -%}
{%- if sw_faq_json != blank -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ sw_faq_json }}]}
</script>
{%- endif -%}

<style>
.sw-ks-wrap{max-width:1280px;margin:0 auto;padding:3rem 1.5rem 5rem;display:grid;grid-template-columns:1fr;gap:2.5rem}
@media(min-width:768px){.sw-ks-wrap{grid-template-columns:220px 1fr}}
.sw-ks-sidebar{align-self:start}@media(min-width:768px){.sw-ks-sidebar{position:sticky;top:7rem}}
.sw-ks-sidebar h3{font-size:.75rem;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.1em;margin:0 0 .75rem;padding:0 .75rem}
.sw-ks-sidebar nav{display:flex;flex-direction:column;gap:.125rem}
.sw-ks-sidebar a{display:block;padding:.5rem .75rem;border-radius:.5rem;color:#374151;font-size:.9375rem;text-decoration:none;font-weight:500;transition:background .15s,color .15s;line-height:1.4}
.sw-ks-sidebar a:hover{background:#EBF2FF;color:#0F6FE3}
.sw-ks-sidebar a.sw-active{background:#EBF2FF;color:#083D7D;font-weight:700;border-left:3px solid #0F6FE3;padding-left:calc(.75rem - 3px)}
.sw-faq-item{border-bottom:1px solid #e5e7eb;overflow:hidden}
.sw-faq-btn{width:100%;background:none;border:none;padding:1.25rem 1rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer;text-align:left;gap:1rem}
.sw-faq-btn:hover{background:#f9fafb}
.sw-faq-q{font-weight:600;color:#111827;font-size:1rem}
.sw-faq-icon{width:1.5rem;height:1.5rem;border-radius:50%;background:#EBF2FF;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .2s}
.sw-faq-answer{max-height:0;overflow:hidden;transition:max-height .3s ease,padding .3s ease}
.sw-faq-answer.open{max-height:500px}
.sw-faq-answer-inner{padding:.25rem 1rem 1.25rem;color:#6b7280;font-size:.9375rem;line-height:1.7}
</style>

<div style="background:#f9fafb">
  <div class="sw-ks-wrap">
    <aside class="sw-ks-sidebar">
      <h3>{{ 'sw.nav.klantenservice' | t }}</h3>
      <nav>
        <a href="{{ sw_root }}/pages/contact">Contact</a>
        <a href="{{ sw_root }}/pages/over-ons">{{ 'sw.nav.overons' | t }}</a>
        <a href="{{ sw_root }}/pages/veelgestelde-vragen">{{ 'sw.nav.faq' | t }}</a>
        <a href="{{ sw_root }}/pages/verzending-retouren">{{ 'sw.nav.verzending' | t }}</a>
        <a href="{{ sw_root }}/pages/garantie">{{ 'sw.nav.garantie' | t }}</a>
        <a href="{{ sw_root }}/pages/algemene-voorwaarden">{{ 'sw.nav.voorwaarden' | t }}</a>
        <a href="{{ sw_root }}/pages/privacyverklaring">{{ 'sw.nav.privacy' | t }}</a>
      </nav>
    </aside>

    <div>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2.5rem" id="swFaqCats">
        <button onclick="swFaqFilter('all')" style="padding:.375rem 1rem;border-radius:9999px;font-size:.875rem;font-weight:600;cursor:pointer;border:2px solid #083D7D;background:#083D7D;color:#fff">{{ 'sw.faq.alle' | t }}</button>
        {%- for sw_c in sw_cats offset: 1 -%}
          {%- assign sw_naam = sw_c | split: '</h2>' | first | strip_html | strip -%}
          <button onclick="swFaqFilter('cat{{ forloop.index }}')" style="padding:.375rem 1rem;border-radius:9999px;font-size:.875rem;font-weight:600;cursor:pointer;border:2px solid #e5e7eb;background:#fff;color:#374151">{{ sw_naam }}</button>
        {%- endfor -%}
      </div>

      <div style="background:#fff;border-radius:1rem;box-shadow:0 1px 4px rgba(0,0,0,0.07);overflow:hidden">
        {%- for sw_c in sw_cats offset: 1 -%}
          {%- assign sw_catnr = forloop.index -%}
          {%- assign sw_na_h2 = sw_c | split: '</h2>' | last -%}
          {%- assign sw_vragen = sw_na_h2 | split: '<h3>' -%}
          {%- for sw_v in sw_vragen offset: 1 -%}
            {%- assign sw_vraag = sw_v | split: '</h3>' | first | strip_html | strip -%}
            {%- assign sw_antwoord = sw_v | split: '</h3>' | last | strip -%}
            <div class="sw-faq-item" data-cat="cat{{ sw_catnr }}">
              <button class="sw-faq-btn" onclick="swFaqToggle(this)"><span class="sw-faq-q">{{ sw_vraag }}</span><span class="sw-faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#083D7D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span></button>
              <div class="sw-faq-answer"><div class="sw-faq-answer-inner">{{ sw_antwoord }}</div></div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

<div style="margin-top:3rem;background:#061f40;border-radius:1rem;padding:2rem;text-align:center">
        <h3 style="color:#fff;font-weight:700;font-size:1.125rem;margin:0 0 .5rem">{{ 'sw.faq.slot_kop' | t }}</h3>
        <p style="color:#93c5fd;font-size:.9375rem;margin:0 0 1.5rem">{{ 'sw.faq.slot_tekst' | t }}</p>
        <a href="{{ sw_root }}/pages/contact" style="display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.75rem;background:linear-gradient(135deg,#083D7D,#0F6FE3);color:#fff;font-weight:700;border-radius:.625rem;text-decoration:none">{{ 'sw.faq.slot_knop' | t }}</a>
      </div>
    </div>
  </div>
</div>
<script>
document.querySelectorAll('.sw-ks-sidebar a').forEach(function(a){
  if(a.pathname===window.location.pathname){a.classList.add('sw-active');}
});
function swFaqToggle(btn){
  var answer=btn.nextElementSibling;
  var icon=btn.querySelector('.sw-faq-icon');
  var isOpen=answer.classList.contains('open');
  document.querySelectorAll('.sw-faq-answer.open').forEach(function(a){a.classList.remove('open');});
  document.querySelectorAll('.sw-faq-icon').forEach(function(i){i.style.transform='rotate(0deg)';});
  if(!isOpen){answer.classList.add('open');icon.style.transform='rotate(180deg)';}
}
function swFaqFilter(cat){
  document.querySelectorAll('.sw-faq-item').forEach(function(item){
    item.style.display=(cat==='all'||item.getAttribute('data-cat')===cat)?'block':'none';
  });
  document.querySelectorAll('#swFaqCats button').forEach(function(btn){
    var isActive=btn.getAttribute('onclick').includes("'"+cat+"'");
    btn.style.background=isActive?'#083D7D':'#fff';
    btn.style.color=isActive?'#fff':'#374151';
    btn.style.borderColor=isActive?'#083D7D':'#e5e7eb';
  });
}
</script>

{% schema %}
{
  "name": "FAQ Body",
  "settings": []
}
{% endschema %}
