

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{%- liquid
  assign sw_rail_sort = false
  assign sw_catalog_sort = false
  assign sw_default_sort = collection.default_sort_by
  assign sw_infinite_scroll = section.settings.enable_infinite_scroll
  if collection.handle contains 'railverlichting' or collection.handle == '1-fase-rails-en-onderdelen'
    if collection.sort_by == blank or collection.sort_by == 'manual' or collection.sort_by == 'relevance'
      assign sw_rail_sort = true
      assign sw_infinite_scroll = false
    endif
  elsif collection.handle contains 'inbouwspot' or collection.handle contains 'inbouw-spot'
    # Preserve recessed spotlight collections.
  else
    assign sw_default_sort = 'manual'
    if collection.sort_by == blank or collection.sort_by == 'manual'
      assign sw_catalog_sort = true
      assign sw_infinite_scroll = false
    endif
  endif
  assign sw_sort_cards = false
  if sw_rail_sort or sw_catalog_sort
    assign sw_sort_cards = true
  endif
  assign sw_stock_sort = sw_sort_cards
  if collection.sort_by == blank or collection.sort_by == sw_default_sort
    assign sw_stock_sort = true
  endif
  if sw_stock_sort
    assign sw_infinite_scroll = false
  endif
  assign sw_merge_catalog = false
  if sw_stock_sort and collection.products_count > 250
    assign sw_merge_catalog = true
  endif
-%}
{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ sw_infinite_scroll }}"
  {% if sw_merge_catalog %}data-sw-collection-size="{{ collection.products_count }}"{% endif %}
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {%- comment -%}
      De teller boven het raster telde producten, terwijl er een tegel per kleur staat:
      "22 artikelen" boven 58 tegels. Hij telt nu de kleuren mee, net als de badge in de
      kop. Een for-loop over collection.products stopt bij 50 items, dus bij grotere
      collecties valt hij terug op het productaantal.
    {%- endcomment -%}
    {%- liquid
      assign sw_tegels = 0
      assign sw_geteld = 0
      for sw_p in collection.products limit: 250
        assign sw_geteld = sw_geteld | plus: 1
        assign sw_k = 0
        for sw_o in sw_p.options_with_values
          if sw_o.name == 'Kleur' or sw_o.name == 'Color' or sw_o.name == 'Colour'
            assign sw_k = sw_o.values.size
          endif
        endfor
        if sw_k > 1
          assign sw_tegels = sw_tegels | plus: sw_p.variants.size
        else
          assign sw_tegels = sw_tegels | plus: 1
        endif
      endfor
      # Een for-loop over collection.products stopt na 50 items, ook met een hogere limit;
      # gemeten op /collections/all. Ziet de loop niet alles, dan is de telling
      # onbetrouwbaar en tonen we het aantal producten.
      if sw_geteld < collection.products_count
        assign sw_tegels = collection.products_count
      endif
      if sw_tegels <= collection.products_count
        assign sw_tegels = collection.products_count
      endif
    -%}
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: sw_tegels,
      default_sort_by: sw_default_sort
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {%- if sw_stock_sort -%}
      {%- comment -%}Sort related colour tiles together before rendering the product grid.{%- endcomment -%}
      {%- assign products_per_page = 250 -%}
    {%- endif -%}

    {% paginate collection.products by products_per_page %}
      {%- assign sw_page_key = paginate.current_page | prepend: '00000' | slice: -5, 5 -%}
      {% capture children %}
        {% assign sw_tegel = 0 %}
        {% for product in collection.products limit: 250 %}
          {%- liquid
            # Producten met meerdere kleuren krijgen een tegel per kleur. De kleuren zijn
            # sinds de samenvoeging varianten van één product; zonder dit zag de klant op
            # de collectiepagina nog maar één uitvoering staan.
            # Eén tegel per kleur, niet per variant. Sinds een kleur meerdere lichtkleuren
            # kan hebben, gaf één tegel per variant tien tegels voor dezelfde spot.
            assign sw_kleuren = 0
            assign sw_kleur_idx = -1
            assign sw_kleur_eerste = ''
            assign sw_gezien = ''
            for sw_opt in product.options_with_values
              if sw_opt.name == 'Kleur' or sw_opt.name == 'Color' or sw_opt.name == 'Colour'
                assign sw_kleuren = sw_opt.values.size
                assign sw_kleur_eerste = sw_opt.values | join: "," | downcase
                assign sw_kleur_idx = forloop.index0
              endif
            endfor
          -%}
          {%- liquid
            # Eén tegel per kleur, ook bij een product met maar één kleur, zolang die kleur nog
            # niet in de modelnaam staat. Nodig sinds uitvoeringen die op specs verschillen eigen
            # producten met dezelfde naam kregen: Cavo Chroom en Cavo Zilver stonden anders als
            # "LED Inbouwspot Cavo" naast elkaar, zonder kleur in de titel en met een diavoorstelling
            # die ook de maatschets liet zien.
            assign sw_per_kleur = false
            if sw_kleuren > 1
              assign sw_per_kleur = true
            elsif sw_kleuren == 1
              assign sw_model = product.title | split: "|" | first | downcase
              assign sw_kleur_kort = sw_kleur_eerste | split: " " | last
              unless sw_model contains sw_kleur_kort
                assign sw_per_kleur = true
              endunless
            endif
          -%}
          {%- if sw_per_kleur -%}
            {%- for variant in product.variants -%}
              {%- assign sw_mark = '|' | append: variant.options[sw_kleur_idx] | append: '|' -%}
              {%- if sw_gezien contains sw_mark -%}{%- continue -%}{%- endif -%}
              {%- assign sw_gezien = sw_gezien | append: sw_mark -%}
              {%- assign sw_tegel = sw_tegel | plus: 1 -%}
              {%- if sw_stock_sort -%}
                {%- capture sw_tile_key -%}
                  {%- if variant.available -%}0{%- else -%}1{%- endif -%}
                  {%- if sw_sort_cards -%}
                    {%- render 'sw-collection-sort-key', product: product, colour: variant.options[sw_kleur_idx], collection_handle: collection.handle, rail_sort: sw_rail_sort -%}
                  {%- else -%}
                    {{- sw_page_key -}}{{- sw_tegel | prepend: '000000' | slice: -6, 6 -}}
                  {%- endif -%}
                {%- endcapture -%}
                SWCOLLECTIONITEM{{ sw_tile_key }}SWCOLLECTIONHTML
              {%- endif -%}
              <li
                id="{{ section.id }}-{{ product.id }}-{{ variant.id }}"
                class="product-grid__item product-grid__item--{{ sw_tegel | minus: 1 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                {% if sw_merge_catalog %}data-sw-sort-key="{{ sw_tile_key | escape }}"{% endif %}
                ref="cards[]"
              >
                {% render 'sw-variant-card', product: product, variant: variant %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- assign sw_tegel = sw_tegel | plus: 1 -%}
            {%- if sw_stock_sort -%}
              {%- capture sw_tile_key -%}
                {%- if product.available -%}0{%- else -%}1{%- endif -%}
                {%- if sw_sort_cards -%}
                  {%- render 'sw-collection-sort-key', product: product, colour: sw_kleur_eerste, collection_handle: collection.handle, rail_sort: sw_rail_sort -%}
                {%- else -%}
                  {{- sw_page_key -}}{{- sw_tegel | prepend: '000000' | slice: -6, 6 -}}
                {%- endif -%}
              {%- endcapture -%}
              SWCOLLECTIONITEM{{ sw_tile_key }}SWCOLLECTIONHTML
            {%- endif -%}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ sw_tegel | minus: 1 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              {% if sw_merge_catalog %}data-sw-sort-key="{{ sw_tile_key | escape }}"{% endif %}
              ref="cards[]"
            >
              {% # theme-check-disable %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}
            </li>
          {%- endif -%}
        {% endfor %}
      {% endcapture %}

      {%- if sw_stock_sort -%}
        {%- assign sw_sorted_cards = children | split: 'SWCOLLECTIONITEM' | sort -%}
        {%- capture children -%}
          {%- for sw_card in sw_sorted_cards -%}
            {%- if sw_card contains 'SWCOLLECTIONHTML' -%}
              {{- sw_card | split: 'SWCOLLECTIONHTML' | last -}}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
      {%- endif -%}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: sw_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
