          {{ type | payment_type_svg_tag: class: 'sw-pay-svg' }}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function() {
  function initSwProductPage() {
    if (document.querySelector('.sw-vol')) return;
    var form = document.querySelector('form.shopify-product-form');
    if (!form) { form = document.querySelector('button[name="add"]'); }
    if (!form || form.closest('cart-drawer-component, [id*="CartDrawer"], .cart-drawer')) return;

    // De kleurkiezer is verwijderd: Shopify tekent hem nu zelf uit de Kleur-variant.

    // Volume pricing (clickable, updates quantity)
    // Bij een product met meerdere varianten verandert de prijs zonder herladen. De staffel
    // moet dan mee. We lezen daarom de prijs die op het scherm staat in plaats van de
    // Liquid-waarde, en herberekenen zodra die tekst verandert.
    // Niet zomaar de eerste prijs op de pagina pakken. Het uitklapmenu, de zoeksuggesties,
    // de aanbevolen producten en de winkelwagen-la bevatten allemaal productkaartjes met
    // een prijs, en die staan eerder in de DOM dan het product zelf. Daardoor stond bij
    // Movo (23,95) een staffel van 11,95 - de prijs van een kaartje in het menu.
    var swNietDeProductprijs = '[id*="cart"], .cart-drawer, .cart-items, .sticky-add-to-cart,' +
      ' .resource-card, menu-drawer, .menu-drawer, header, .header, .predictive-search,' +
      ' product-recommendations, .sw-fbt, .sw-pp-card, dialog';
    function swZoekProductprijs(sel) {
      return Array.prototype.slice.call(document.querySelectorAll(sel)).find(function(el) {
        return !el.closest(swNietDeProductprijs);
      }) || null;
    }
    var swPriceEl = swZoekProductprijs('.price__regular .price, .price-item--sale');
    function swLeesPrijs(val) {
      if (!swPriceEl) return val;
      var m = (swPriceEl.textContent || '').replace(/\s/g, '').match(/([\d.]+),(\d{2})/);
      if (!m) return val;
      return parseFloat(m[1].replace(/\./g, '') + '.' + m[2]);
    }
    var price = swLeesPrijs({{ product.price | divided_by: 100.0 }});
    var tiers = [
      { qty: 1, label: '1 stuk', discount: 0 },
      { qty: 10, label: '10 stuks', discount: 0.02 },
      { qty: 50, label: '50 stuks', discount: 0.05 }
    ];
    var volHtml = '<div class="sw-vol" style="display:flex;gap:.5rem;margin-bottom:1rem;flex-wrap:wrap">';
    tiers.forEach(function(tier, i) {
      var tp = price * (1 - tier.discount);
      var isFirst = i === 0;
      var border = isFirst ? '2px solid #061f40' : '1.5px solid #d1d5db';
      var bg = isFirst ? 'background:#f8faff;' : '';
      volHtml += '<div class="sw-vol-tier" data-qty="' + tier.qty + '" data-index="' + i + '" style="flex:1;min-width:90px;border:' + border + ';border-radius:6px;padding:.5rem .625rem;cursor:pointer;' + bg + 'transition:border-color .15s,background .15s">' +
        '<div style="font-size:.75rem;font-weight:700;color:#061f40">' + tier.label + '</div>' +
        '<div style="font-size:.9rem;font-weight:800;color:#061f40">&euro;' + tp.toFixed(2).replace('.',',') + '/stuk</div>';
      if (tier.discount > 0) {
        volHtml += '<div style="font-size:.7rem;color:#0F6FE3;font-weight:600">▼ ' + Math.round(tier.discount * 100) + '% korting</div>';
      }
      volHtml += '</div>';
    });
    volHtml += '</div>';
    form.insertAdjacentHTML('beforebegin', volHtml);

    // Make volume tiers clickable &mdash; update quantity input
    document.querySelectorAll('.sw-vol-tier').forEach(function(tier) {
      tier.addEventListener('click', function() {
        var qty = parseInt(this.dataset.qty);
        // Update quantity input
        var qtyInput = document.querySelector('input[name="quantity"], quantity-selector input[type="number"]');
        if (qtyInput) {
          qtyInput.value = qty;
          qtyInput.dispatchEvent(new Event('change', {bubbles: true}));
        }
        // Visual: highlight selected tier
        document.querySelectorAll('.sw-vol-tier').forEach(function(t) {
          t.style.border = '1.5px solid #d1d5db';
          t.style.background = '#fff';
        });
        this.style.border = '2px solid #061f40';
        this.style.background = '#f8faff';
      });
    });

    // Wisselt de klant van variant, dan verandert de prijs zonder herladen. Deze observer
    // rekent de staffelbedragen opnieuw uit zodra de getoonde prijs verandert.
    if (swPriceEl) {
      new MutationObserver(function() {
        var nieuw = swLeesPrijs(price);
        if (!nieuw || nieuw === price) return;
        price = nieuw;
        document.querySelectorAll('.sw-vol-tier').forEach(function(t) {
          var idx = parseInt(t.dataset.index, 10);
          var bedrag = price * (1 - tiers[idx].discount);
          var regel = t.children[1];
          if (regel) regel.textContent = '€' + bedrag.toFixed(2).replace('.', ',') + '/stuk';
        });
      }).observe(swPriceEl, { childList: true, characterData: true, subtree: true });
    }

    // Stars + Op voorraad after price (universal)
    var priceWrap = swZoekProductprijs('.price__regular');
    if (priceWrap && !document.querySelector('.sw-extras')) {
      priceWrap.insertAdjacentHTML('afterend',
        '<div class="sw-extras" style="display:flex;align-items:center;gap:1rem;margin:.5rem 0 .75rem;flex-wrap:wrap">' +
        
        '<div style="display:flex;align-items:center;gap:.3rem">' +
        '<span style="color:#16a34a;font-size:.9rem">&#9679;</span>' +
        '<span style="color:#16a34a;font-size:.82rem;font-weight:600">Op voorraad</span>' +
        '<span style="color:#94a3b8;font-size:.78rem">&mdash; direct leverbaar</span></div>' +
        '</div>');
    }

    // Hide buy it now
    document.querySelectorAll('.shopify-payment-button, .shopify-payment-button__button, accelerated-checkout-component').forEach(function(el) {
      el.style.setProperty('display','none','important');
    });

    // Specificaties tabel &mdash; inject after payment icons section
    function injectSpecs() {
      if (document.querySelector('.sw-specs-table')) return;
      var specsSource = document.getElementById('sw-specs-source');
      if (!specsSource) return;
      // Try: inject after .sw-delivery or after form parent
      var anchor = document.querySelector('.sw-delivery') || form.parentElement;
      if (anchor) {
        anchor.insertAdjacentHTML('afterend', specsSource.innerHTML);
      }
    }
    injectSpecs();

    // Delivery badge + payment icons + lichtkleur
    if (!document.querySelector('.sw-delivery')) {
      // Find the trust bullets or form parent to insert after
      var trustList = Array.from(document.querySelectorAll('ul')).find(function(ul) {
        return ul.textContent.includes('Gratis verzenden') || ul.textContent.includes('retourrecht');
      });
      var insertTarget = trustList || form.parentElement;

      var deliveryHtml =
        '<div class="sw-delivery" style="display:flex;align-items:center;gap:.5rem;margin:.75rem 0 .25rem;padding:.6rem .875rem;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0">' +
        '<span style="color:#16a34a;font-size:1.1rem">&#9679;</span>' +
        '<span style="font-size:.875rem;color:#15803d;font-weight:600">Vandaag besteld, morgen verzonden</span>' +
        '</div>';

      // Payment icons &mdash; grab from the hidden Liquid-rendered div
      var paySource = document.getElementById('sw-pay-icons-source');
      if (paySource) {
        deliveryHtml += paySource.innerHTML;
      }

      insertTarget.insertAdjacentHTML('afterend', deliveryHtml);
    }

  }

  // Robuuste main-image switcher voor Horizon media-gallery
  window.swSwitchMain = function(thumbEl){
    try {
      var url = thumbEl.dataset.fullSrc;
      if (!url) return;
      document.querySelectorAll('.sw-thumbs img').forEach(function(t){ t.style.border='1.5px solid #e2e8f0'; });
      thumbEl.style.border='2px solid #061f40';
      var mediaCol = document.querySelector('.product-information__media');
      if (!mediaCol) return;
      // Update alle main media img/source elementen (sla onze eigen .sw-thumbs over)
      mediaCol.querySelectorAll('img, source').forEach(function(el){
        if (el.closest && el.closest('.sw-thumbs')) return;
        if (el.tagName === 'SOURCE') {
          el.srcset = url;
        } else {
          el.removeAttribute('srcset');
          el.removeAttribute('data-src');
          el.src = url;
          if (el.loading === 'lazy') el.loading = 'eager';
        }
      });
    } catch(e){ console.log('swSwitchMain err', e); }
  };

  // Thumbnail strip + Specs table (universal)
  function initSwThumbs() {
    var mediaCol = document.querySelector('.product-information__media');
    if (!mediaCol) return;
    // Inject thumbs INSIDE de sticky media-gallery zodat ze meebewegen, niet erover
    var stickyTarget = mediaCol.querySelector('media-gallery') || mediaCol;
    // Skip alleen als thumbs AL in stickyTarget staan (niet in hidden source)
    if (stickyTarget.querySelector('.sw-thumbs')) return;
    var source = document.getElementById('sw-thumbs-source');
    if (!source) return;
    // Main image override (voor producten met placeholder als hoofdfoto)
    var override = source.getAttribute('data-main-override');
    if (override) {
      mediaCol.querySelectorAll('img, source').forEach(function(el){
        if (el.closest && el.closest('.sw-thumbs')) return;
        if (el.tagName === 'SOURCE') {
          el.srcset = override;
        } else {
          el.removeAttribute('srcset');
          el.removeAttribute('data-src');
          el.src = override;
          if (el.loading === 'lazy') el.loading = 'eager';
        }
      });
    }
    // (De class sw-main-img-ready-html stond hier voor een FOUC-fix, maar geen enkele
    //  CSS-regel in de theme leest hem nog — de bijbehorende regels zijn eerder al
    //  verwijderd. Weggehaald zodat er geen dode flag blijft rondslingeren.)
    // Dedupliceer thumbnails op URL voor injectie
    var tempDiv = document.createElement('div');
    tempDiv.innerHTML = source.innerHTML;
    var seenUrls = {};
    tempDiv.querySelectorAll('img').forEach(function(img) {
      // Dedupliceren op de volledige bestandsnaam, alleen de Shopify-maatsuffix
      // (_1200x, _150x150) eraf. NIET op '_' splitsen: Shopify zet een uniek ID
      // achter een underscore in de bestandsnaam, waardoor alle foto's van een
      // product dezelfde sleutel kregen en er maar één thumbnail overbleef.
      var url = (img.getAttribute('data-full-src') || img.src || '')
        .split('?')[0]
        .replace(/_(\d+x\d*|x\d+)(?=\.[a-zA-Z]+$)/, '');
      if (seenUrls[url]) {
        img.remove();
      } else {
        seenUrls[url] = true;
      }
    });
    stickyTarget.insertAdjacentHTML('beforeend', tempDiv.innerHTML);
    // Specs tabel onder thumbnails injecteren (alleen als nog niet in mediaCol)
    var specsSource = document.getElementById('sw-specs-source');
    if (specsSource && !mediaCol.querySelector('.sw-specs-table')) {
      mediaCol.insertAdjacentHTML('beforeend', specsSource.innerHTML);
    }
  }

  // Welke variant staat er op dit moment in het bestelformulier? Dat veld is de enige
  // bron die Horizon bij een kleurwissel meteen bijwerkt; de URL loopt soms achter.
  // Zonder deze kaart vergelijkt het filter een variant-id met een kleurnaam.
  window.SW_VARIANT_KLEUR = window.SW_VARIANT_KLEUR || {};
  {%- assign sw_ki = -1 -%}
  {%- for sw_opt in product.options -%}{%- if sw_opt == 'Kleur' -%}{%- assign sw_ki = forloop.index0 -%}{%- endif -%}{%- endfor -%}
  {%- if sw_ki >= 0 -%}
    {%- for sw_v in product.variants -%}
  window.SW_VARIANT_KLEUR['{{ sw_v.id }}'] = {{ sw_v.options[sw_ki] | json }};
    {%- endfor -%}
  {%- endif %}

  function swHuidigeVariant(){
    var inp = document.querySelector('form.shopify-product-form input[name="id"], product-form-component input[name="id"]');
    if (inp && inp.value) return String(inp.value);
    var uit = new URLSearchParams(location.search).get('variant');
    return uit ? String(uit) : '';
  }

  // Toont alleen de foto's van de gekozen kleur. Elke thumb draagt in data-owner de
  // variant waar hij bij hoort; foto's zonder eigenaar horen bij het hele product.
  // Hoort er bij deze kleur niets, dan tonen we alles in plaats van een lege strook.
  var swBezig = false;
  var swLaatsteVariant = null;
  function swFilterThumbs(forceer){
    if (swBezig) return;
    var strip = document.querySelector('.product-information__media .sw-thumbs');
    if (!strip) return;
    var alle = Array.prototype.slice.call(strip.querySelectorAll('img[data-owner]'));
    if (!alle.length) return;
    var vid = swHuidigeVariant();
    // Zonder deze check zou de observer zichzelf blijven aanroepen: dit filter past de
    // DOM aan, wat weer een mutatie is.
    if (!forceer && vid === swLaatsteVariant) return;
    swLaatsteVariant = vid;
    swBezig = true;
    try { swPasFilterToe(strip, alle, vid); } finally { setTimeout(function(){ swBezig = false; }, 0); }
  }
  function swPasFilterToe(strip, alle, vid){
    var sleutel = (window.SW_VARIANT_KLEUR || {})[vid] || vid;
    var tonen = alle.filter(function(el){
      var o = el.getAttribute('data-owner');
      return !o || o === sleutel;
    });
    if (!tonen.length) tonen = alle;
    tonen = tonen.slice(0, 8);
    alle.forEach(function(el){
      var mee = tonen.indexOf(el) > -1;
      el.style.display = mee ? '' : 'none';
      el.style.border = (mee && el === tonen[0]) ? '2px solid #061f40' : '1.5px solid #e2e8f0';
    });
    // Geen opvulling meer. Had een kleur minder dan vijf foto's, dan herhaalden we de
    // eerste tot de rij vol was — bij Lyvo Mat Zwart stond de hoofdfoto daardoor twee
    // keer in de strook, op plek 1 en 5. Vier foto's tonen is eerlijker dan vijf waarvan
    // er een dubbel is.
    strip.querySelectorAll('img[data-kloon]').forEach(function(el){ el.remove(); });
  }
  window.swFilterThumbs = swFilterThumbs;

  // Bij een kleurwissel herlaadt de pagina niet. Zonder deze haken bleef de strook op de
  // kleur staan waarmee je binnenkwam en klopte het pas na een refresh.
  function swVolgVariantWissel(){
    document.addEventListener('change', function(e){
      if (e.target && e.target.closest && e.target.closest('variant-picker, form.shopify-product-form, product-form-component')) {
        setTimeout(swFilterThumbs, 60);
      }
    }, true);
    document.addEventListener('click', function(e){
      if (e.target && e.target.closest && e.target.closest('variant-picker')) {
        setTimeout(swFilterThumbs, 120);
        setTimeout(swFilterThumbs, 400);
      }
    }, true);
    window.addEventListener('popstate', function(){ setTimeout(swFilterThumbs, 60); });

    // Horizon bouwt de media-gallery opnieuw op bij een wissel; dan is onze strook weg.
    var mediaCol = document.querySelector('.product-information__media');
    if (mediaCol) {
      new MutationObserver(function(){
        if (swBezig) return;
        if (!mediaCol.querySelector('.sw-thumbs')) { initSwThumbs(); swFilterThumbs(true); }
        else { swFilterThumbs(); }
      }).observe(mediaCol, { childList: true, subtree: true });
    }
  }

  function initAll(){
    initSwProductPage();
    initSwThumbs();
    swFilterThumbs();
    swVolgVariantWissel();
    if(document.body) document.body.classList.add('sw-product-ready');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>
<style>
/* Voorkom FOUC: verberg variant picker + product form tot mijn JS klaar is, dan smooth fade-in */
.product-information__details variant-picker-component,
.product-information__details .product-form,
.product-information__details product-form-component{opacity:0;transition:opacity .15s ease-out}
body.sw-product-ready .product-information__details variant-picker-component,
body.sw-product-ready .product-information__details .product-form,
body.sw-product-ready .product-information__details product-form-component{opacity:1}
/* Reserveer ruimte voor de ingevoegde staffelprijzen zodat de layout niet verspringt */
.product-information__details:not(.sw-product-ready) .product-form{min-height:280px}
/* Smooth fade voor sw-injected elementen */
.sw-vol,.sw-extras,.sw-delivery,.sw-payment-icons,.sw-specs-table,.sw-thumbs{animation:swFadeIn .2s ease-out}
@keyframes swFadeIn{from{opacity:0}to{opacity:1}}
/* Fix: toon Lichtkleur picker voor 2-temp producten — Horizon zet fieldset op display:none tijdens init */
variant-picker fieldset.variant-option{display:grid !important}
</style>

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
  /* Hide only extra variant labels (Dimbaar/IP-waarde) in cart, keep product row visible */
  .cart-items__variant-option:not(:first-child) {
    display: none !important;
  }
  /* Hide Buy it now */
  .shopify-payment-button,
  .shopify-payment-button__button,
  .product-form__payment-wrapper,
  accelerated-checkout-component {
    display: none !important;
  }
  /* Thumbnails inside sticky gallery */
  media-gallery {
    overflow: visible !important;
  }
  .product-information__media {
    position: relative;
  }
  /* Verberg Horizon native slideshow-controls thumbnails — vervangen door sw-thumbs */
  slideshow-controls,
  .slideshow-controls__thumbnails-container {
    display: none !important;
  }
  .sw-thumbs {
    position: relative;
    z-index: 100;
    background: #fff;
    padding-top: 8px;
    clear: both;
  }
  /* Spotwereld: gradient buy button */
  form.cart-form button[type="submit"],
  button[name="add"] {
    background: linear-gradient(135deg, #083D7D 0%, #0F6FE3 100%) !important;
    border: none !important;
    border-radius: 8px !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em !important;
  }
  form.cart-form button[type="submit"]:hover,
  button[name="add"]:hover {
    background: linear-gradient(135deg, #062d5c 0%, #0a5abf 100%) !important;
  }
  .shopify-payment-button__button--unbranded {
    background: linear-gradient(135deg, #0F6FE3 0%, #083D7D 100%) !important;
    border-radius: 8px !important;
  }
  .sw-pay-svg {
    height: 24px;
    width: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
