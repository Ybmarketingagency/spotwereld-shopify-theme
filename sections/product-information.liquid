

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper add-to-cart-icon">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product_media_size: closest.product.media.size,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{%- comment -%}
  De handgeschreven kleurkiezer is weg. Elke kleurfamilie is nu één product met echte
  Kleur-varianten, dus Shopify tekent de kiezer zelf en prijs, SKU, foto en variant-ID
  lopen automatisch mee.
{%- endcomment -%}

<!-- Spotwereld: Thumbnails - extras uit product.media; geen externe lookups meer -->
{%- liquid
  assign sw_main_override = blank
  assign sw_extras = ''
-%}
<div id="sw-thumbs-source" style="display:none" data-main-override="{{ sw_main_override }}">
  <div class="sw-thumbs" style="display:flex;gap:8px;margin-top:10px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:4px">
    {%- comment -%} Als sw_main_override actief is: gebruik die als 1ste thumb (geselecteerd) en skip product.media (placeholder) {%- endcomment -%}
    {%- if sw_main_override != blank -%}
      <img src="{{ sw_main_override }}" alt="{{ product.title | escape }}" loading="lazy"
           data-full-src="{{ sw_main_override }}"
           style="width:76px;height:76px;flex-shrink:0;object-fit:cover;border-radius:6px;border:2px solid #061f40;cursor:pointer;transition:all .15s;background:#fff"
           onclick="swSwitchMain(this)">
    {%- elsif product.media.size > 0 -%}
      {%- comment -%}
        Alleen de foto's van de gekozen kleur. Sinds de kleuren varianten van één product
        zijn, hangt per kleur maar één foto aan zijn variant; de rest staat los en die
        toonde Shopify onder élke kleur. Je zag dan zwarte platen bij Mat Wit.

        We gaan op de volgorde af, niet op de bestandsnaam. Bij het samenvoegen zijn de
        foto's per kleur achter elkaar gezet, met de hoofdfoto van die kleur voorop. Alles
        vanaf de hoofdfoto van een kleur tot aan de volgende hoort dus bij die kleur.

        Op bestandsnamen kun je niet varen: bij Faro heten ook de foto's van Zwart-Goud
        'kanlux-...-wit-goud', en bij Feno staan er Engelse kleuren in (fs41-black).

        Foto's vóór de eerste hoofdfoto horen bij niemand en blijven staan. Levert het
        filter niets op, dan tonen we gewoon alles.
      {%- endcomment -%}
      {%- comment -%}
        Eén doorloop: we lopen de media op volgorde langs en houden bij van welke kleur we
        bezig zijn. Zodra we de hoofdfoto van een kleur tegenkomen, is die kleur de
        eigenaar tot de hoofdfoto van de volgende kleur langskomt.

        Eerder deed ik dit in twee passes met een lijst van id's als tekst. Dat gaf bij
        Faro Wit-Goud vier foto's van Zwart-Goud terug. Zo hoeft er niets vergeleken te
        worden en kan die fout niet meer optreden.
      {%- endcomment -%}
      {%- comment -%}
        Alle foto's komen mee, elk met de kleur waar hij bij hoort in data-owner. Welke
        er zichtbaar zijn bepaalt swFilterThumbs in JavaScript.

        Waarom niet hier filteren: bij het wisselen van kleur laadt de pagina niet
        opnieuw, dus deze Liquid draait maar één keer. Filterde ik hier, dan hield je de
        foto's van de kleur waarmee je binnenkwam en klopte het pas na een refresh.
      {%- endcomment -%}
      {%- liquid
        # Eigenaar is de kleur, niet de variant: een kleur kan meerdere lichtkleuren
        # hebben en die delen dezelfde hoofdfoto.
        assign sw_kleur_idx = -1
        for sw_opt in product.options
          if sw_opt == 'Kleur'
            assign sw_kleur_idx = forloop.index0
          endif
        endfor
      -%}
      {%- assign sw_eigenaar = '' -%}
      {%- for sw_media in product.media limit: 60 -%}
        {%- for sw_v in product.variants -%}
          {%- if sw_v.featured_media.id == sw_media.id -%}
            {%- if sw_kleur_idx >= 0 -%}
              {%- assign sw_eigenaar = sw_v.options[sw_kleur_idx] -%}
            {%- else -%}
              {%- assign sw_eigenaar = sw_v.id -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <img src="{{ sw_media | image_url: width: 150 }}" alt="{{ product.title | escape }}" loading="lazy"
             data-full-src="{{ sw_media | image_url: width: 1200 }}"
             data-owner="{{ sw_eigenaar | escape }}"
             style="width:76px;height:76px;flex-shrink:0;object-fit:cover;border-radius:6px;border:1.5px solid #e2e8f0;cursor:pointer;transition:all .15s;background:#fff"
             onclick="swSwitchMain(this)">
      {%- endfor -%}
    {%- endif -%}
    {%- comment -%} Daarna extra outledtl thumbnails (lookup-based) {%- endcomment -%}
    {%- if sw_extras != '' -%}
      {%- for sw_url in sw_extras_arr -%}
        <img src="{{ sw_url }}" alt="{{ product.title | escape }}" loading="lazy"
             data-full-src="{{ sw_url }}"
             style="width:76px;height:76px;flex-shrink:0;object-fit:cover;border-radius:6px;border:1.5px solid #e2e8f0;cursor:pointer;transition:all .15s;background:#fff"
             onclick="swSwitchMain(this)">
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}
        De kopieën waarmee we een korte strook aanvulden zijn weg. Ze gebruikten
        product.featured_image — de foto van de eerste kleur — en dan stond de witte spot
        onder zwart, zilver en goud. Hoeveel foto's een kleur heeft weten we nu pas in
        JavaScript, dus daar wordt zo nodig aangevuld.
      {%- endcomment -%}
    {%- endif -%}
  </div>
</div>

<!-- SW_SPECS_START -->
<script>
(function(){
  function hideBodySpecs() {
    document.querySelectorAll('rte-formatter h3, .rte h3, .text-block h3').forEach(function(h3) {
      if (h3.textContent.trim() === 'Specificaties') {
        h3.style.display = 'none';
        var next = h3.nextElementSibling;
        while (next && next.tagName !== 'H3' && next.tagName !== 'H2') {
          next.style.display = 'none';
          next = next.nextElementSibling;
        }
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hideBodySpecs);
  } else {
    hideBodySpecs();
  }
  setTimeout(hideBodySpecs, 500);
})();
</script>
<div class="sw-specs-direct" style="max-width:1280px;margin:1.5rem auto 0;padding:0 1.5rem">
  <div class="sw-specs-table" style="margin:1.5rem 0 0;background:#fff;border:1px solid #e8edf4;border-radius:12px;padding:1.5rem 1.75rem 1rem">
    <h3 style="font-size:1rem;font-weight:800;color:#061f40;margin:0 0 .75rem;padding-bottom:.5rem;border-bottom:2px solid #e8edf4">Specificaties</h3>
    {%- comment -%}
      Specificaties komen uit de metafields (Shopify: product > Specificaties).
      Is een metafield leeg, dan wordt alleen gekeken naar wat er letterlijk in de
      producttitel staat (bv. "| 4W |", "| IP65 |", "| Zaagmaat: Ø75 mm |").
      Er wordt NOOIT een standaardwaarde ingevuld: staat het nergens, dan verdwijnt de rij.
      Wat je in de admin invult, wint altijd van de titel.
    {%- endcomment -%}
    {%- assign sw_merk = product.metafields.custom.merk -%}
    {%- assign sw_wattage = product.metafields.custom.wattage -%}
    {%- assign sw_lumen = product.metafields.custom.lichtopbrengst -%}
    {%- comment -%}
      Garantie is geen productspecificatie maar gepubliceerd winkelbeleid: op /pages/garantie
      staat "op alle producten van Spotwereld geldt standaard 5 jaar garantie". Daarom mag dit
      als winkelbrede waarde. Vul je het metafield voor een product wel in, dan wint dat.
    {%- endcomment -%}
    {%- assign sw_garantie = product.metafields.custom.garantie | default: '5 jaar' -%}
    {%- assign sw_levensduur = product.metafields.custom.levensduur -%}
    {%- assign sw_materiaal = product.metafields.custom.materiaal -%}
    {%- assign sw_driver = product.metafields.custom.inclusief_driver -%}
    {%- assign sw_fitting = product.metafields.custom.fitting -%}
    {%- assign sw_ip = product.metafields.custom.ip_waarde -%}
    {%- assign sw_zaagmaat = product.metafields.custom.zaagmaat -%}
    {%- assign sw_diepte = product.metafields.custom.inbouwdiepte -%}
    {%- assign sw_afmetingen = product.metafields.custom.afmetingen -%}
    {%- comment -%}
      Deze vijf stonden tot 2026-08-14 als losse HTML-tabel in de productbeschrijving.
      Nu metavelden, zodat elk product dezelfde opbouw heeft: één alinea tekst plus
      deze tabel. Leeg = de rij verdwijnt, er wordt nooit iets ingevuld dat er niet is.
    {%- endcomment -%}
    {%- assign sw_dimbaar = product.metafields.custom.dimbaar -%}
    {%- assign sw_cri = product.metafields.custom.cri -%}
    {%- assign sw_lichthoek = product.metafields.custom.lichthoek -%}
    {%- assign sw_voltage = product.metafields.custom.voltage -%}
    {%- comment -%}
      Lichtkleur staat normaal als productoptie in de tabel. Heeft een product die optie niet
      (Cavo Dim2Warm bijvoorbeeld: één lichtkleur, dus geen keuze), dan viel de rij helemaal weg.
      Dan pakken we het metaveld.
    {%- endcomment -%}
    {%- assign sw_heeft_lk_optie = false -%}
    {%- for sw_o in product.options -%}{%- if sw_o == 'Lichtkleur' -%}{%- assign sw_heeft_lk_optie = true -%}{%- endif -%}{%- endfor -%}
    {%- assign sw_lichtkleur = '' -%}
    {%- unless sw_heeft_lk_optie -%}
      {%- assign sw_lk_val = product.metafields.custom.lichtkleur.value -%}
      {%- if sw_lk_val != blank -%}
        {%- if sw_lk_val.first -%}{%- assign sw_lichtkleur = sw_lk_val | join: ' · ' -%}
        {%- else -%}{%- assign sw_lichtkleur = sw_lk_val -%}{%- endif -%}
      {%- endif -%}
    {%- endunless -%}
    {%- assign sw_maxwatt = product.metafields.custom.max_wattage -%}

    {%- comment -%} Terugval: uitsluitend waardes die letterlijk in de titel staan {%- endcomment -%}
    {%- assign sw_tparts = product.title | split: '|' -%}
    {%- for tp in sw_tparts -%}
      {%- assign tpx = tp | strip -%}
      {%- assign tpl = tpx | downcase -%}
      {%- if sw_zaagmaat == blank and tpl contains 'zaagmaat:' -%}{%- assign sw_zaagmaat = tpx | split: ':' | last | strip -%}{%- endif -%}
      {%- if sw_diepte == blank and tpl contains 'inbouwdiepte:' -%}{%- assign sw_diepte = tpx | split: ':' | last | strip -%}{%- endif -%}
      {%- if sw_ip == blank and tpl contains 'ip' -%}
        {%- if tpx == 'IP20' or tpx == 'IP44' or tpx == 'IP54' or tpx == 'IP65' or tpx == 'IP66' or tpx == 'IP67' or tpx == 'IP68' -%}{%- assign sw_ip = tpx -%}{%- endif -%}
      {%- endif -%}
      {%- if sw_wattage == blank and tpl contains 'w' -%}
        {%- assign tp_test = tpx | remove: 'W' | remove: '/' | remove: ',' | remove: '.' | strip -%}
        {%- if tp_test != '' and tp_test != tpx -%}
          {%- assign tp_num = tp_test | plus: 0 -%}
          {%- if tp_num > 0 -%}{%- assign sw_wattage = tpx -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- if sw_lumen == blank and tpl contains 'lm' -%}
        {%- assign tp_test = tpx | remove: 'lm' | strip -%}
        {%- assign tp_num = tp_test | plus: 0 -%}
        {%- if tp_num > 0 -%}{%- assign sw_lumen = tp_num | append: ' lm' -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <table style="width:100%;border-collapse:collapse;font-size:.875rem">
      <tbody>
        {%- if product.selected_or_first_available_variant.sku != blank -%}
        <tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500;width:45%">SKU</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ product.selected_or_first_available_variant.sku }}</td></tr>
        {%- endif -%}
        {%- if sw_merk != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Merk</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_merk }}</td></tr>{%- endif -%}
        {%- if sw_levensduur != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Verwachte levensduur</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_levensduur }}</td></tr>{%- endif -%}
        {%- if sw_garantie != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Garantie</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_garantie }}</td></tr>{%- endif -%}
        {%- if sw_materiaal != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Materiaal</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_materiaal }}</td></tr>{%- endif -%}
        {%- if sw_wattage != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Wattage</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_wattage }}</td></tr>{%- endif -%}
        {%- if sw_maxwatt != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Max. wattage lichtbron</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_maxwatt }}</td></tr>{%- endif -%}
        {%- if sw_lumen != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Lichtopbrengst</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_lumen }}</td></tr>{%- endif -%}
        {%- if sw_lichthoek != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Lichthoek</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_lichthoek }}</td></tr>{%- endif -%}
        {%- if sw_cri != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Kleurweergave (CRI)</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_cri }}</td></tr>{%- endif -%}
        {%- if sw_dimbaar != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Dimbaar</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_dimbaar }}</td></tr>{%- endif -%}
        {%- if sw_driver != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Inclusief driver</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_driver }}</td></tr>{%- endif -%}
        {%- if sw_fitting != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Fitting</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_fitting }}</td></tr>{%- endif -%}
        {%- if sw_ip != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">IP-waarde</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_ip }}</td></tr>{%- endif -%}
        {%- if sw_zaagmaat != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#061f40;font-weight:800">Zaagmaat</td><td style="padding:.6rem 0;color:#061f40;font-weight:800">{{ sw_zaagmaat }}</td></tr>{%- endif -%}
        {%- if sw_diepte != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#061f40;font-weight:800">Inbouwdiepte</td><td style="padding:.6rem 0;color:#061f40;font-weight:800">{{ sw_diepte }}</td></tr>{%- endif -%}
        {%- if sw_afmetingen != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Afmetingen</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_afmetingen }}</td></tr>{%- endif -%}
        {%- if sw_voltage != blank -%}<tr style="border-bottom:1px solid #f0f3f8;background:#f8fafc"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Voltage</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_voltage }}</td></tr>{%- endif -%}
        {%- if sw_lichtkleur != blank -%}<tr style="border-bottom:1px solid #f0f3f8"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Lichtkleur</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ sw_lichtkleur }}</td></tr>{%- endif -%}
        {%- for opt in product.options_with_values -%}
          {%- assign opt_name = opt.name | downcase -%}
          {%- unless opt_name == 'title' or opt_name == 'ip-waarde' -%}
          <tr style="border-bottom:1px solid #f0f3f8{% cycle 'specrow': '', ';background:#f8fafc' %}"><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">{%- if opt_name == 'kleur' -%}Kleur behuizing{%- else -%}{{ opt.name }}{%- endif -%}</td><td style="padding:.6rem 0;color:#1e293b;font-weight:600">{{ product.selected_or_first_available_variant.options[forloop.index0] }}</td></tr>
          {%- endunless -%}
        {%- endfor -%}
        <tr><td style="padding:.6rem .75rem .6rem 0;color:#6b7280;font-weight:500">Beschikbaarheid</td><td style="padding:.6rem 0;font-weight:600;color:{%- if product.available -%}#16a34a{%- else -%}#dc2626{%- endif -%}">{%- if product.available -%}Op voorraad{%- else -%}Uitverkocht{%- endif -%}</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Reviewcarrousel verwijderd: er zijn nog geen echte klantreviews, dus geen sterren of citaten. -->

<!-- Spotwereld: Payment icons from Shopify (same as footer) -->
<div id="sw-pay-icons-source" style="display:none">
  <div class="sw-payment-icons" style="margin:1.25rem 0 .5rem">
    <p style="font-size:.8rem;font-weight:700;color:#374151;margin:0 0 .5rem">Veilig shoppen met</p>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
      {%- assign sw_pay_types = 'ideal,visa,mastercard,paypal,klarna,bancontact' | split: ',' -%}
      {%- for type in sw_pay_types -%}
