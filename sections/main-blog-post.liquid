

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <header>
      {%- content_for 'block', id: 'blog-post-title', type: 'text' %}
      {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}
    </header>

    {%- if article.image -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}
    {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}

    {%- comment -%}
      Spotwereld E-E-A-T (22-09-2026). De kennisbank had geen enkel auteurssignaal: geen naam,
      geen verantwoording, geen datum van controle. Google noemt dat bij Search Quality onder
      "Who, How and Why" als iets wat op elke informatieve pagina zichtbaar hoort te zijn.
      Verzinnen mag niet, dus dit blok toont alleen wat controleerbaar is: de uitgever met
      KvK-nummer en vestigingsadres, waar de inhoud op gebaseerd is, en wanneer het artikel
      voor het laatst is bijgewerkt. Staat er in de sectie-instellingen een naam ingevuld,
      dan verschijnt die als auteur; anders is de winkel zelf de auteur.
    {%- endcomment -%}
    {%- liquid
      assign sw_at_en = false
      if request.locale.iso_code == 'en'
        assign sw_at_en = true
      endif
      assign sw_at_naam = section.settings.sw_auteur_naam | default: article.author | strip
      if sw_at_naam == blank or sw_at_naam == 'Spotwereld'
        assign sw_at_naam = 'Spotwereld'
        assign sw_at_persoon = false
      else
        assign sw_at_persoon = true
      endif
    -%}
    <aside class="sw-verantwoording">
      <h2>{% if sw_at_en %}About this article{% else %}Over dit artikel{% endif %}</h2>
      <dl>
        <dt>{% if sw_at_en %}Written by{% else %}Geschreven door{% endif %}</dt>
        <dd>
          {{ sw_at_naam | escape }}{% if sw_at_persoon and section.settings.sw_auteur_functie != blank %}, {{ section.settings.sw_auteur_functie | escape }}{% endif %}
          {%- unless sw_at_persoon -%}
            <span class="sw-verantwoording__sub">{% if sw_at_en %}LED lighting specialist, Blaricum (NL) &middot; Chamber of Commerce 84665688{% else %}gespecialiseerd in led-verlichting, Blaricum &middot; KvK 84665688{% endif %}</span>
          {%- endunless -%}
        </dd>

        <dt>{% if sw_at_en %}Based on{% else %}Gebaseerd op{% endif %}</dt>
        <dd>{% if sw_at_en %}European standards and regulations, the manufacturer documentation of our suppliers, and the measured specifications of the fixtures we sell ourselves. Figures that a supplier does not state, we leave out.{% else %}Europese normen en verordeningen, de fabrikantendocumentatie van onze leveranciers, en de opgemeten specificaties van de armaturen die we zelf verkopen. Cijfers die een leverancier niet opgeeft, laten we weg.{% endif %}</dd>

        <dt>{% if sw_at_en %}Last updated{% else %}Laatst bijgewerkt{% endif %}</dt>
        <dd>
          <time datetime="{{ article.updated_at | default: article.published_at | date: '%Y-%m-%d' }}">
            {%- if sw_at_en -%}
              {{ article.updated_at | default: article.published_at | date: '%e %B %Y' | strip }}
            {%- else -%}
              {{ article.updated_at | default: article.published_at | date: '%d-%m-%Y' }}
            {%- endif -%}
          </time>
        </dd>

        <dt>{% if sw_at_en %}Spotted an error?{% else %}Klopt er iets niet?{% endif %}</dt>
        <dd>{% if sw_at_en %}Mail{% else %}Mail{% endif %} <a href="mailto:info@spotwereld.nl?subject={{ article.title | url_encode }}">info@spotwereld.nl</a>{% if sw_at_en %} and we will check it.{% else %} en we kijken het na.{% endif %}</dd>
      </dl>
    </aside>

    {%- comment -%}
      Bijpassende producten (21-09-2026). Uit GA4 over 22 aug t/m 21 sep: de kennisbank
      trekt bezoek maar leverde nul bestellingen. De artikelen linken wel naar producten,
      maar alleen als tekstlink midden in een alinea. Dit blok haalt de producten die in het
      artikel zelf gelinkt worden uit de tekst en zet ze als kaart met foto en prijs onder
      het artikel, plus een knop naar de collectie die als eerste in het artikel voorkomt.
      Er hoeft dus niets per artikel ingesteld te worden: schrijft de motor een link naar
      /products/led-inbouwspot-lesto, dan staat Lesto hier als kaart.
      Maximaal vier kaarten, alleen producten die nog bestaan en beschikbaar zijn.
    {%- endcomment -%}
    {%- liquid
      assign sw_bp_delen = article.content | split: '/products/'
      assign sw_bp_lijst = ','
      assign sw_bp_coll = ''
      for sw_bp_deel in sw_bp_delen offset: 1
        assign sw_bp_h = sw_bp_deel | split: '"' | first | split: "'" | first | split: '?' | first | split: '#' | first | split: '/' | first | strip
        assign sw_bp_zoek = ',' | append: sw_bp_h | append: ','
        unless sw_bp_h == blank or sw_bp_lijst contains sw_bp_zoek
          assign sw_bp_lijst = sw_bp_lijst | append: sw_bp_h | append: ','
        endunless
      endfor
      assign sw_bp_handles = sw_bp_lijst | split: ','
      assign sw_bp_cdelen = article.content | split: '/collections/'
      if sw_bp_cdelen.size > 1
        assign sw_bp_coll = sw_bp_cdelen[1] | split: '"' | first | split: "'" | first | split: '?' | first | split: '#' | first | split: '/' | first | strip
      endif
      assign sw_bp_aantal = 0
    -%}
    {%- capture sw_bp_kaarten -%}
      {%- for sw_bp_h in sw_bp_handles -%}
        {%- if sw_bp_h == blank -%}{%- continue -%}{%- endif -%}
        {%- if sw_bp_aantal >= 4 -%}{%- break -%}{%- endif -%}
        {%- assign sw_bp_p = all_products[sw_bp_h] -%}
        {%- if sw_bp_p == blank or sw_bp_p.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign sw_bp_aantal = sw_bp_aantal | plus: 1 -%}
        {%- assign sw_bp_naam = sw_bp_p.title | split: '|' | first | strip -%}
        {%- comment -%}
          De knop onder de kaarten wijst naar de hoofdcategorie van het eerste product, niet naar
          de eerste collectielink in de tekst: een badkamerartikel over inbouwspots linkte in
          een bijzin naar wandlampen en kreeg daardoor "Bekijk alle wandlampen" onder vier
          inbouwspots. Alleen als geen enkel product in een hoofdcategorie zit, valt hij terug
          op de eerste collectielink uit het artikel.
        {%- endcomment -%}
        {%- if sw_bp_aantal == 1 -%}
          {%- for sw_bp_pc in sw_bp_p.collections -%}
            {%- if sw_bp_pc.handle == 'inbouwspots' or sw_bp_pc.handle == 'opbouwspots' or sw_bp_pc.handle == 'wandlampen' or sw_bp_pc.handle == 'hanglampen' or sw_bp_pc.handle == 'trapverlichting' or sw_bp_pc.handle == 'led-panelen' or sw_bp_pc.handle == 'led-tl-buizen' or sw_bp_pc.handle == 'accessoires' -%}
              {%- assign sw_bp_coll = sw_bp_pc.handle -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <a class="sw-bp__kaart" href="{{ sw_bp_p.url }}">
          {%- if sw_bp_p.featured_image -%}
            <img src="{{ sw_bp_p.featured_image | image_url: width: 400 }}" alt="{{ sw_bp_p.featured_image.alt | default: sw_bp_naam | escape }}" loading="lazy" width="400" height="400">
          {%- endif -%}
          <span class="sw-bp__naam">{{ sw_bp_naam | escape }}</span>
          <span class="sw-bp__prijs">
            {%- if sw_bp_p.price_varies -%}{% if request.locale.iso_code == 'en' %}from{% else %}vanaf{% endif %} {% endif -%}
            {{ sw_bp_p.price_min | money }}
          </span>
        </a>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if sw_bp_aantal > 0 -%}
      <aside class="sw-bp">
        <h2 class="sw-bp__kop">{% if request.locale.iso_code == 'en' %}Products mentioned in this article{% else %}De producten uit dit artikel{% endif %}</h2>
        <div class="sw-bp__rij">{{ sw_bp_kaarten }}</div>
        {%- if sw_bp_coll != blank -%}
          {%- assign sw_bp_c = collections[sw_bp_coll] -%}
          {%- if sw_bp_c != blank and sw_bp_c.products_count > 0 -%}
            <a class="sw-bp__alles" href="{{ sw_bp_c.url }}">{% if request.locale.iso_code == 'en' %}View all{% else %}Bekijk alle{% endif %} {{ sw_bp_c.title | escape }} ({{ sw_bp_c.products_count }})</a>
          {%- endif -%}
        {%- endif -%}
      </aside>
    {%- endif -%}


    {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>


{%- comment -%}
  Spotwereld blogmotor: kennisbank-artikelen werden alleen vanaf de verlichtingsgids
  gelinkt, met een handmatige kaart per artikel. Bij dagelijkse publicatie is dat niet
  vol te houden en worden het weespaginas. Dit blok linkt elk artikel automatisch aan
  drie andere: eerst artikelen die een tag delen, daarna de nieuwste.
{%- endcomment -%}
{%- assign sw_getoond = 0 -%}
{%- capture sw_kaarten -%}
  {%- for sw_kandidaat in blog.articles -%}
    {%- if sw_kandidaat.id == article.id -%}{%- continue -%}{%- endif -%}
    {%- if sw_getoond >= 3 -%}{%- break -%}{%- endif -%}
    {%- assign sw_deelt = false -%}
    {%- for sw_tag in article.tags -%}
      {%- if sw_kandidaat.tags contains sw_tag -%}{%- assign sw_deelt = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if sw_deelt -%}
      {%- assign sw_getoond = sw_getoond | plus: 1 -%}
      <a class="sw-verder-lezen__kaart" href="{{ sw_kandidaat.url }}">
        {%- if sw_kandidaat.image -%}
          <img src="{{ sw_kandidaat.image | image_url: width: 400 }}" alt="{{ sw_kandidaat.image.alt | default: sw_kandidaat.title | escape }}" loading="lazy" width="400" height="{{ 400 | divided_by: sw_kandidaat.image.aspect_ratio | round }}">
        {%- endif -%}
        <span>{{ sw_kandidaat.title | escape }}</span>
      </a>
    {%- endif -%}
  {%- endfor -%}
  {%- for sw_kandidaat in blog.articles -%}
    {%- if sw_kandidaat.id == article.id -%}{%- continue -%}{%- endif -%}
    {%- if sw_getoond >= 3 -%}{%- break -%}{%- endif -%}
    {%- assign sw_deelt = false -%}
    {%- for sw_tag in article.tags -%}
      {%- if sw_kandidaat.tags contains sw_tag -%}{%- assign sw_deelt = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- unless sw_deelt -%}
      {%- assign sw_getoond = sw_getoond | plus: 1 -%}
      <a class="sw-verder-lezen__kaart" href="{{ sw_kandidaat.url }}">
        {%- if sw_kandidaat.image -%}
          <img src="{{ sw_kandidaat.image | image_url: width: 400 }}" alt="{{ sw_kandidaat.image.alt | default: sw_kandidaat.title | escape }}" loading="lazy" width="400" height="{{ 400 | divided_by: sw_kandidaat.image.aspect_ratio | round }}">
        {%- endif -%}
        <span>{{ sw_kandidaat.title | escape }}</span>
      </a>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if sw_getoond > 0 -%}
  <aside class="sw-verder-lezen">
    <h2>{% if request.locale.iso_code == 'en' %}More from the lighting guide{% else %}Meer uit de verlichtingsgids{% endif %}</h2>
    <div class="sw-verder-lezen__rij">{{ sw_kaarten }}</div>
    <a class="sw-verder-lezen__alles" href="{{ routes.root_url | append: '/pages/verlichtingsgids' | replace: '//', '/' }}">{% if request.locale.iso_code == 'en' %}All articles in the lighting guide{% else %}Alle artikelen in de verlichtingsgids{% endif %}</a>
  </aside>
{%- endif -%}

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{%- comment -%}
  Spotwereld: aanvulling op Shopify's `article | structured_data`. Dat filter levert wel
  headline, image, datePublished en author, maar niet publisher, dateModified,
  mainEntityOfPage of description — allemaal velden die Google voor Article verwacht.
  Los blok met eigen @id zodat het niet met het bovenstaande botst.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "{{ request.origin }}{{ article.url }}#article",
  "headline": "{{ article.title | escape }}",
  "description": "{{ article.excerpt_or_content | strip_html | truncate: 200 | escape }}",
  "url": "{{ request.origin }}{{ article.url }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ request.origin }}{{ article.url }}"
  },
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  {%- if article.image -%}
  "image": {
    "@type": "ImageObject",
    "url": "https:{{ article.image | image_url: width: 1200 }}",
    "width": 1200,
    "height": {{ 1200 | divided_by: article.image.aspect_ratio | round }}
  },
  {%- endif -%}
  "author": { "@id": "{{ request.origin }}/#organization" },
  "publisher": { "@id": "{{ request.origin }}/#organization" },
  "isAccessibleForFree": true,
  "inLanguage": "{% if request.locale.iso_code == 'en' %}en{% else %}nl-NL{% endif %}"
  {%- if article.tags.size > 0 -%}
  ,"keywords": "{{ article.tags | join: ', ' | escape }}"
  {%- endif -%}
}
</script>


{%- comment -%}
  Spotwereld blogmotor: elk kennisbank-artikel eindigt met een blok
  <div class="sw-artikel-faq"> met <h3>-vragen en <p>-antwoorden. Daar bouwen we
  FAQPage-schema uit, uit exact dezelfde bron als wat de bezoeker leest.
  Zonder zo'n blok in het artikel gebeurt er niets.
{%- endcomment -%}
{%- assign sw_faq_split = article.content | split: '<div class="sw-artikel-faq">' -%}
{%- if sw_faq_split.size > 1 -%}
  {%- assign sw_faq_blok = sw_faq_split[1] | split: '</div>' | first -%}
  {%- assign sw_faq_items = sw_faq_blok | split: '<h3>' -%}
  {%- capture sw_faq_json -%}
    {%- for sw_item in sw_faq_items offset: 1 -%}
      {%- assign sw_q = sw_item | split: '</h3>' | first | strip_html | strip -%}
      {%- assign sw_na = sw_item | split: '</h3>' | last -%}
      {%- assign sw_a = sw_na | split: '<p>' | last | split: '</p>' | first | strip_html | strip -%}
      {%- if sw_q != blank and sw_a != blank -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {"@type":"Question","name":{{ sw_q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ sw_a | json }}}}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign sw_faq_json = sw_faq_json | strip -%}
  {%- if sw_faq_json != blank -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","@id":"{{ request.origin }}{{ article.url }}#faq","mainEntity":[{{ sw_faq_json }}]}
</script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}

  /* Spotwereld: verantwoordingsblok onder het artikel (E-E-A-T, 22-09-2026) */
  .sw-verantwoording {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 2rem auto 0;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid #e8edf4;
    border-left: 3px solid #061f40;
    border-radius: 12px;
    background: #fff;
  }

  .sw-verantwoording h2 {
    margin: 0 0 0.9rem;
    font-size: 1rem;
    font-weight: 800;
    color: #061f40;
    letter-spacing: -0.01em;
  }

  .sw-verantwoording dl {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .sw-verantwoording dt {
    margin: 0;
    font-weight: 700;
    color: #061f40;
  }

  .sw-verantwoording dd {
    margin: 0;
    color: #475569;
  }

  .sw-verantwoording__sub {
    display: block;
    font-size: 0.8125rem;
    color: #64748b;
  }

  .sw-verantwoording a {
    color: #061f40;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 600px) {
    .sw-verantwoording dl {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .sw-verantwoording dd {
      margin-bottom: 0.6rem;
    }
  }

  /* Spotwereld: producten uit het artikel als kaart, onder de tekst */
  .sw-bp {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0.5rem auto 0;
    padding: 1.5rem 1.5rem 1.6rem;
    background: #f8fafc;
    border: 1px solid #e8edf4;
    border-radius: 14px;
  }

  .sw-bp__kop {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: #061f40;
    letter-spacing: -0.01em;
  }

  .sw-bp__rij {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .sw-bp__kaart {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: #fff;
    border: 1px solid #e8edf4;
    border-radius: 10px;
    padding: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .sw-bp__kaart:hover {
    border-color: #b9cbe4;
    box-shadow: 0 6px 18px rgba(6, 31, 64, 0.08);
  }

  .sw-bp__kaart img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border-radius: 6px;
    background: #fff;
  }

  .sw-bp__naam {
    font-size: 0.9rem;
    font-weight: 700;
    color: #061f40;
    line-height: 1.3;
  }

  .sw-bp__prijs {
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f6fe3;
  }

  .sw-bp__alles {
    display: inline-block;
    margin-top: 1.1rem;
    padding: 0.7rem 1.1rem;
    background: #083d7d;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
  }

  .sw-bp__alles:hover {
    background: #061f40;
  }

  @media screen and (max-width: 749px) {
    .sw-bp {
      padding: 1.1rem 1rem 1.2rem;
    }

    .sw-bp__rij {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
  /* Spotwereld blogmotor: verwante artikelen onder een kennisbank-artikel */
  .sw-verder-lezen {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 3.5rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .sw-verder-lezen h2 {
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
  }

  .sw-verder-lezen__rij {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .sw-verder-lezen__kaart {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    line-height: 1.35;
  }

  .sw-verder-lezen__kaart img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .sw-verder-lezen__alles {
    display: inline-block;
    margin-top: 1.5rem;
  }

  @media screen and (max-width: 749px) {
    .sw-verder-lezen__rij {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Spotwereld blogmotor: FAQ-blok onder aan een kennisbank-artikel */
  .sw-artikel-faq {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .sw-artikel-faq h3 {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .sw-artikel-faq h3:first-child {
    margin-top: 0;
  }

  .sw-artikel-faq p {
    margin: 0;
    opacity: 0.85;
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Over dit artikel"
    },
    {
      "type": "paragraph",
      "content": "Blijft dit leeg, dan staat Spotwereld zelf als auteur onder elk kennisbank-artikel, met KvK-nummer en vestigingsplaats. Vul een naam in zodra er een vaste schrijver is."
    },
    {
      "type": "text",
      "id": "sw_auteur_naam",
      "label": "Naam van de auteur",
      "info": "Leeg laten om de winkel als auteur te tonen."
    },
    {
      "type": "text",
      "id": "sw_auteur_functie",
      "label": "Functie of vakgebied",
      "info": "Bijvoorbeeld: elektrotechnisch installateur. Alleen zichtbaar als er een naam staat."
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
