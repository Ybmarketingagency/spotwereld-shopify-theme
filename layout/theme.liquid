{%- assign sw_root = routes.root_url | append: '/' | replace: '//', '/' | remove_last: '/' -%}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- comment -%}
      Spotwereld: /collections/all is Shopify's automatische lijst en kent geen handmatige
      volgorde (altijd alfabetisch, dus accessoires bovenaan). De gecureerde volgorde
      - inbouwspots eerst - leeft op de collectie 'alle-producten'. Stuur bezoekers daarheen.
      Zo vroeg mogelijk in de head zodat er niets van de verkeerde pagina in beeld komt.
    {%- endcomment -%}
    {%- if collection.handle == 'all' and request.design_mode == false -%}
      <script>
        window.location.replace('/collections/alle-producten' + window.location.search + window.location.hash);
      </script>
    {%- endif -%}

    {%- comment -%} Spotwereld favicon: blauwe O-spotlight uit logo - overrules Shopify Brand setting {%- endcomment -%}
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
    <link rel="shortcut icon" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- comment -%}
      Domeinverificatie van Meta. Moet als gewone tag in de statische head staan: Meta's
      scraper voert geen JavaScript uit, dus een via script ingevoegde tag telt niet.
      Hoort bij het bedrijfsportfolio Voltkracht, domein-ID 2115576176499556.
    {%- endcomment -%}
    <meta name="facebook-domain-verification" content="gzudje94pkqy44bop47qha0lbkz06l">

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    {%- comment -%}
      Schil en opmaak van de verlichtingsgids. De artikelen zelf (templates/page.*.liquid)
      bevatten alleen semantische HTML; alle opmaakregels staan hier, op één plek.
      Palet bewust beperkt: inkt, grijs, hairline en één donkerblauw accent voor links.
      Geen gradients, geen groen, geen amber.
    {%- endcomment -%}
    {% assign sw_vg = false %}
    {% if template == 'page.inbouwspots-plaatsen' or template == 'page.led-dimmer-kiezen' or template == 'page.tl-naar-led' or template == 'page.verlichtingsgids' %}
      {% assign sw_vg = true %}
    {% endif %}

    {% if sw_vg %}
    <style>
    .sw-vg-outer{
      --sw-ink:#12181f;
      --sw-body:#414a55;
      --sw-muted:#767f8b;
      --sw-rule:#e2e5e9;
      --sw-fill:#f7f8f9;
      --sw-accent:#0a3a72;
      background:#fff;
    }
    .sw-vg-wrap{max-width:1140px;margin:0 auto;padding:2.5rem 1.5rem 5rem;display:grid;grid-template-columns:1fr;gap:2.5rem;align-items:start}
    @media(min-width:900px){.sw-vg-wrap{grid-template-columns:216px 1fr;gap:3.5rem;padding-top:3.5rem}}

    /* zijbalk */
    .sw-vg-sidebar{order:2;font-size:.9375rem}
    @media(min-width:900px){.sw-vg-sidebar{order:0;align-self:start;position:sticky;top:6.5rem;border-right:1px solid var(--sw-rule);padding-right:1.75rem}}
    @media(max-width:899px){.sw-vg-sidebar{border-top:1px solid var(--sw-rule);padding-top:1.75rem}}
    .sw-vg-sidebar-head{font-size:.6875rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--sw-muted);margin:0 0 1.25rem}
    .sw-vg-nav{display:block}
    .sw-vg-nav a{display:block;padding:.375rem 0 .375rem .875rem;border-left:2px solid var(--sw-rule);color:var(--sw-body);text-decoration:none;line-height:1.45;transition:color .15s,border-color .15s}
    .sw-vg-nav a:hover{color:var(--sw-ink);border-left-color:#b9c0c8}
    .sw-vg-nav a.sw-active{color:var(--sw-ink);font-weight:600;border-left-color:var(--sw-accent)}
    .sw-vg-nav-cat{display:block;font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#a7aeb6;margin:1.5rem 0 .5rem}
    .sw-vg-nav-cat.sw-first{margin-top:0}
    .sw-vg-sidebar-cta{margin-top:1.75rem;padding-top:1.25rem;border-top:1px solid var(--sw-rule)}
    .sw-vg-sidebar-cta a{display:block;color:var(--sw-accent);text-decoration:none;font-weight:600;font-size:.875rem;margin-bottom:.625rem}
    .sw-vg-sidebar-cta a:last-child{margin-bottom:0}
    .sw-vg-sidebar-cta a:hover{text-decoration:underline}

    /* artikel */
    .sw-vg-content{min-width:0;color:var(--sw-body);font-size:1.0625rem;line-height:1.7}
    .sw-vg-content > *{max-width:44rem}
    .sw-vg-content .sw-crumb{font-size:.8125rem;color:var(--sw-muted);margin:0 0 1.75rem}
    .sw-vg-content .sw-crumb a{color:var(--sw-muted);text-decoration:none}
    .sw-vg-content .sw-crumb a:hover{color:var(--sw-ink);text-decoration:underline}
    .sw-vg-content .sw-crumb span{padding:0 .4rem;color:#c3c9d0}
    .sw-vg-content .sw-kicker{font-size:.6875rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--sw-muted);margin:0 0 .875rem}
    .sw-vg-content h1{font-size:clamp(1.75rem,3.4vw,2.375rem);font-weight:700;color:var(--sw-ink);letter-spacing:-.02em;line-height:1.18;margin:0 0 1rem}
    .sw-vg-content .sw-lead{font-size:1.1875rem;line-height:1.6;color:#525b66;margin:0 0 1.75rem}
    .sw-vg-content .sw-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-size:.8125rem;color:var(--sw-muted);padding:.875rem 0;border-top:1px solid var(--sw-rule);border-bottom:1px solid var(--sw-rule);margin:0 0 2.5rem}
    .sw-vg-content h2{font-size:1.375rem;font-weight:700;color:var(--sw-ink);letter-spacing:-.012em;line-height:1.3;margin:2.75rem 0 .875rem}
    .sw-vg-content h3{font-size:1.0625rem;font-weight:700;color:var(--sw-ink);line-height:1.4;margin:1.75rem 0 .5rem}
    .sw-vg-content p{margin:0 0 1.125rem}
    .sw-vg-content a{color:var(--sw-accent);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
    .sw-vg-content strong{color:var(--sw-ink);font-weight:600}
    .sw-vg-content ul,.sw-vg-content ol{margin:0 0 1.25rem;padding-left:1.25rem}
    .sw-vg-content li{margin-bottom:.5rem}
    .sw-vg-content li > ul,.sw-vg-content li > ol{margin-top:.5rem}

    /* inhoudsopgave */
    .sw-vg-content .sw-toc{background:var(--sw-fill);border:1px solid var(--sw-rule);padding:1.25rem 1.5rem;margin:0 0 2.5rem}
    .sw-vg-content .sw-toc p{font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--sw-muted);margin:0 0 .625rem}
    .sw-vg-content .sw-toc ol{margin:0;padding-left:1.1rem;font-size:.9375rem}
    .sw-vg-content .sw-toc li{margin-bottom:.3rem}
    .sw-vg-content .sw-toc a{color:var(--sw-body);text-decoration:none}
    .sw-vg-content .sw-toc a:hover{color:var(--sw-ink);text-decoration:underline}

    /* stappen */
    .sw-vg-content .sw-steps{list-style:none;margin:1.75rem 0 2rem;padding:0;counter-reset:swstep}
    .sw-vg-content .sw-steps > li{counter-increment:swstep;position:relative;margin:0 0 0 .8125rem;padding:0 0 1.75rem 2.5rem;border-left:1px solid var(--sw-rule)}
    .sw-vg-content .sw-steps > li:last-child{border-left-color:transparent;padding-bottom:0}
    .sw-vg-content .sw-steps > li::before{content:counter(swstep);position:absolute;left:-.8125rem;top:-.125rem;width:1.625rem;height:1.625rem;border-radius:50%;background:#fff;border:1px solid var(--sw-rule);color:var(--sw-ink);font-size:.75rem;font-weight:700;display:flex;align-items:center;justify-content:center}
    .sw-vg-content .sw-steps h3{margin:0 0 .375rem}
    .sw-vg-content .sw-steps p{margin:0 0 .5rem;font-size:1rem}
    .sw-vg-content .sw-steps p:last-child{margin-bottom:0}

    /* notities */
    .sw-vg-content .sw-note{border-left:3px solid var(--sw-ink);background:var(--sw-fill);padding:1.125rem 1.375rem;margin:1.75rem 0;font-size:.9688rem;line-height:1.65}
    .sw-vg-content .sw-note--tip{border-left-color:#c3c9d0}
    .sw-vg-content .sw-note p{margin:0 0 .625rem}
    .sw-vg-content .sw-note p:last-child{margin-bottom:0}
    .sw-vg-content .sw-note-label{display:block;font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--sw-ink);margin-bottom:.5rem}

    /* tabellen */
    .sw-vg-content .sw-table-scroll{overflow-x:auto;margin:1.75rem 0 2rem}
    .sw-vg-content .sw-table{width:100%;border-collapse:collapse;font-size:.9375rem;margin:1.75rem 0 2rem}
    .sw-vg-content .sw-table-scroll .sw-table{margin:0;min-width:30rem}
    .sw-vg-content .sw-table th{text-align:left;font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--sw-ink);padding:0 1.25rem .625rem 0;border-bottom:1px solid var(--sw-ink);white-space:nowrap}
    .sw-vg-content .sw-table td{padding:.75rem 1.25rem .75rem 0;border-bottom:1px solid var(--sw-rule);vertical-align:top}
    .sw-vg-content .sw-table td:first-child{color:var(--sw-ink);font-weight:600}
    .sw-vg-content .sw-table th:last-child,.sw-vg-content .sw-table td:last-child{padding-right:0}

    /* twee kolommen */
    .sw-vg-content .sw-cols{display:grid;grid-template-columns:1fr;gap:1.25rem;margin:1.75rem 0 2rem}
    @media(min-width:640px){.sw-vg-content .sw-cols{grid-template-columns:1fr 1fr}}
    .sw-vg-content .sw-cols > div{border:1px solid var(--sw-rule);padding:1.25rem 1.375rem}
    .sw-vg-content .sw-cols h3{margin:0 0 .625rem;font-size:1rem}
    .sw-vg-content .sw-cols p{font-size:.9375rem;margin:0 0 .625rem}
    .sw-vg-content .sw-cols p:last-child{margin-bottom:0}
    .sw-vg-content .sw-cols ul{margin:0;padding-left:1.1rem;font-size:.9375rem}
    .sw-vg-content .sw-cols li{margin-bottom:.375rem}

    /* veelgestelde vragen */
    .sw-vg-content .sw-faq{border-top:1px solid var(--sw-rule);margin:1.75rem 0 2rem}
    .sw-vg-content .sw-faq > div{border-bottom:1px solid var(--sw-rule);padding:1.125rem 0}
    .sw-vg-content .sw-faq h3{margin:0 0 .375rem;font-size:1rem}
    .sw-vg-content .sw-faq p{margin:0;font-size:.9688rem}

    /* afsluiter */
    .sw-vg-content .sw-cta{border:1px solid var(--sw-rule);border-top:2px solid var(--sw-ink);padding:1.75rem;margin:3rem 0 0}
    .sw-vg-content .sw-cta h2{margin:0 0 .5rem;font-size:1.125rem}
    .sw-vg-content .sw-cta p{margin:0 0 1.25rem;font-size:.9688rem}
    .sw-vg-content .sw-cta p:last-child{margin-bottom:0}
    .sw-vg-content a.sw-btn{display:inline-block;background:var(--sw-ink);color:#fff;text-decoration:none;padding:.75rem 1.375rem;font-weight:600;font-size:.9375rem;transition:background .15s}
    .sw-vg-content a.sw-btn:hover{background:var(--sw-accent);color:#fff}

    /* overzichtspagina */
    .sw-vg-content .sw-hub{border-top:1px solid var(--sw-rule);margin:2rem 0 0}
    .sw-vg-content .sw-hub a{display:grid;grid-template-columns:1fr;gap:1.125rem;padding:1.75rem 0;border-bottom:1px solid var(--sw-rule);text-decoration:none;color:inherit}
    @media(min-width:640px){.sw-vg-content .sw-hub a{grid-template-columns:196px 1fr;gap:1.75rem;align-items:start}}
    .sw-vg-content .sw-hub img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:var(--sw-fill)}
    .sw-vg-content .sw-hub .sw-kicker{margin:0 0 .375rem}
    .sw-vg-content .sw-hub h2{margin:0 0 .5rem;font-size:1.1875rem;line-height:1.35}
    .sw-vg-content .sw-hub p{margin:0 0 .625rem;font-size:.9375rem;line-height:1.6}
    .sw-vg-content .sw-hub .sw-more{font-size:.875rem;font-weight:600;color:var(--sw-accent)}
    .sw-vg-content .sw-hub a:hover h2{text-decoration:underline}
    </style>
    {% endif %}

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {%- render 'sw-breadcrumbs' -%}

      {% if sw_vg %}
        <div class="sw-vg-outer">
          <div class="sw-vg-wrap">
            {%- comment -%}
              De zijbalk noemde alleen de drie losse gidspagina's en liet de
              blogartikelen weg. Sinds de kennisbank en de gids samen zijn
              wijst hij naar de onderwerpgroepen op de gidspagina; dezelfde
              indeling en volgorde als in snippets/sw-kennisbank-lijst.liquid.
              Op de losse gidspagina's linken de ankers terug naar de gids.
            {%- endcomment -%}
            {%- liquid
              assign sw_vg_en = false
              if request.locale.iso_code == 'en'
                assign sw_vg_en = true
              endif
              assign sw_vg_basis = ''
              unless page.handle == 'verlichtingsgids'
                assign sw_vg_basis = sw_root | append: '/pages/verlichtingsgids'
              endunless
            -%}
            <aside class="sw-vg-sidebar">
              <p class="sw-vg-sidebar-head">{% if sw_vg_en %}Knowledge base{% else %}Kennisbank{% endif %}</p>
              <nav class="sw-vg-nav">
                <span class="sw-vg-nav-cat sw-first">{% if sw_vg_en %}Subjects{% else %}Onderwerpen{% endif %}</span>
                <a href="{{ sw_vg_basis }}#kb-1">{% if sw_vg_en %}Recessed spots{% else %}Inbouwspots{% endif %}</a>
                <a href="{{ sw_vg_basis }}#kb-2">{% if sw_vg_en %}Stair lighting{% else %}Trapverlichting{% endif %}</a>
                <a href="{{ sw_vg_basis }}#kb-3">{% if sw_vg_en %}Dimming{% else %}Dimmen{% endif %}</a>
                <a href="{{ sw_vg_basis }}#kb-4">{% if sw_vg_en %}Colour and output{% else %}Lichtkleur en opbrengst{% endif %}</a>
                <a href="{{ sw_vg_basis }}#kb-5">{% if sw_vg_en %}Tubes and panels{% else %}TL-buizen en panelen{% endif %}</a>
                <span class="sw-vg-nav-cat">{% if sw_vg_en %}Step by step{% else %}Stap voor stap{% endif %}</span>
                <a href="{{ sw_root }}/pages/inbouwspots-plaatsen">{% if sw_vg_en %}Fitting recessed spots{% else %}Inbouwspots plaatsen{% endif %}</a>
                <a href="{{ sw_root }}/pages/tl-naar-led">{% if sw_vg_en %}Replacing TL with LED{% else %}TL vervangen door LED-TL{% endif %}</a>
                <a href="{{ sw_root }}/pages/led-dimmer-kiezen">{% if sw_vg_en %}Choosing a dimmer{% else %}De juiste dimmer kiezen{% endif %}</a>
              </nav>
              <div class="sw-vg-sidebar-cta">
                <a href="{{ sw_root }}/pages/verlichtingsgids">{% if sw_vg_en %}Whole knowledge base{% else %}Hele kennisbank{% endif %}</a>
                <a href="{{ sw_root }}/collections/inbouwspots">{% if sw_vg_en %}To the recessed spots{% else %}Naar de inbouwspots{% endif %}</a>
              </div>
            </aside>
            <div class="sw-vg-content">
              {{ content_for_layout }}
            </div>
          </div>
        </div>
        <script>
        document.querySelectorAll('.sw-vg-nav a').forEach(function(a){
          if(a.pathname===window.location.pathname){a.classList.add('sw-active');}
        });
        </script>
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}
    {% render 'sw-menu-hover-fix' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

  </body>
</html>
