    { "@type": "HowToTool", "name": "Rolmaat en potlood" },
    { "@type": "HowToTool", "name": "Stofzuiger" }
  ],
  "supply": [
    { "@type": "HowToSupply", "name": "LED-inbouwspots met driver" },
    { "@type": "HowToSupply", "name": "Lasklemmen" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Groep uit en controleren",
      "text": "Schakel de groep uit in de meterkast, niet alleen de schakelaar aan de muur. Controleer met een spanningszoeker aan de draad zelf of er geen spanning meer op staat.",
