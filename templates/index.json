    "spotwereld_help_banner": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- assign sw_root = routes.root_url | append: '/' | replace: '//', '/' | remove_last: '/' -%}{%- comment -%}\n  Omgedraaid ten opzichte van de vorige opzet. Die had links een intro en\n  daarnaast twee gelijkwaardige blokken die elk openden met een witte cirkel\n  met een lijnicoontje, plus twee grote decoratieve cirkels op de achtergrond.\n  Dat is precies het stramien van Ledisons.\n\n  Nu staan mail en telefoon vooraan -- dat is ook eerlijker, want dat is het\n  verschil met een grote keten: je krijgt hier iemand aan de lijn die de spots\n  kent. Het zelf regelen via het account is teruggebracht tot een regel\n  onderaan. Geen cirkels meer; de diepte komt van een radiale gloed.\n{%- endcomment -%}<style>.sw-hulp-buiten{background:#061f40;padding:2rem 0 3rem}.sw-hulp-inner{max-width:72rem;margin:0 auto;padding:0 1.5rem}.sw-hulp-band{position:relative;background:linear-gradient(135deg,#142957,#1a3d8f);border-radius:1.5rem;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);padding:2.25rem 2.5rem}.sw-hulp-band::before{content:\"\";position:absolute;inset:0;pointer-events:none;background:radial-gradient(115% 85% at 88% -10%,rgba(15,111,227,.45),transparent 62%)}.sw-hulp-top{position:relative;display:grid;grid-template-columns:1fr;gap:1.75rem;align-items:center}@media(min-width:900px){.sw-hulp-top{grid-template-columns:1fr 1.15fr;gap:3rem}}.sw-hulp-intro h2{font-size:1.5rem;font-weight:800;color:#fff;line-height:1.2;letter-spacing:-.02em;margin:0 0 .6rem;text-wrap:balance}.sw-hulp-intro p{font-size:.9375rem;color:#bfdbfe;line-height:1.6;margin:0}.sw-hulp-tegels{display:grid;grid-template-columns:1fr;gap:.75rem}@media(min-width:620px){.sw-hulp-tegels{grid-template-columns:1fr 1fr}}.sw-hulp-tegel{display:flex;flex-direction:column;gap:.7rem;padding:1.15rem 1.2rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:.875rem;text-decoration:none;transition:background .15s ease,border-color .15s ease,transform .15s ease}.sw-hulp-tegel:hover,.sw-hulp-tegel:focus-visible{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.28);transform:translateY(-2px)}.sw-hulp-teken{width:2.25rem;height:2.25rem;border-radius:.625rem;display:flex;align-items:center;justify-content:center;flex:none}.sw-hulp-waarde{display:block;color:#fff;font-weight:700;font-size:1.0625rem;line-height:1.25;letter-spacing:-.01em}.sw-hulp-sub{display:block;color:#93c5fd;font-size:.75rem;margin-top:.2rem}.sw-hulp-onder{position:relative;margin-top:1.75rem;padding-top:1.35rem;border-top:1px solid rgba(255,255,255,.18)}.sw-hulp-zelf{display:flex;flex-wrap:wrap;align-items:baseline;gap:.35rem .75rem;font-size:.8125rem;color:#a9c4e8}.sw-hulp-zelf b{color:#fff;font-weight:600}.sw-hulp-zelf a{color:#bfdbfe;text-decoration:none;border-bottom:1px solid rgba(191,219,254,.4)}.sw-hulp-zelf a:hover{color:#fff;border-bottom-color:#fff}.sw-hulp-punt{opacity:.35}.sw-hulp-betaal{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-top:1.35rem}.sw-hulp-betaal>span{font-weight:600;font-size:.875rem;color:#fff}.sw-hulp-logos{display:flex;gap:.75rem;flex-wrap:wrap}.sw-hulp-logos div{background:#fff;border-radius:.5rem;padding:.375rem .75rem}.sw-hulp-logos img{height:1.25rem;width:auto;object-fit:contain;display:block}@media(max-width:899px){.sw-hulp-band{padding:1.75rem 1.5rem}}@media(prefers-reduced-motion:reduce){.sw-hulp-tegel{transition:none}}</style><div class=\"sw-hulp-buiten\"><div class=\"sw-hulp-inner\"><div class=\"sw-hulp-band\"><div class=\"sw-hulp-top\"><div class=\"sw-hulp-intro\"><h2>{{ 'sw.home.hulp.kop' | t }}</h2><p>{{ 'sw.home.hulp.tekst' | t }}</p></div><div class=\"sw-hulp-tegels\"><a class=\"sw-hulp-tegel\" href=\"mailto:info@spotwereld.nl\"><span class=\"sw-hulp-teken\" style=\"background:#0F6FE3\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/><polyline points=\"22,6 12,13 2,6\"/></svg></span><span><span class=\"sw-hulp-waarde\">info@spotwereld.nl</span><span class=\"sw-hulp-sub\">{{ 'sw.home.hulp.antwoord' | t }}</span></span></a><a class=\"sw-hulp-tegel\" href=\"tel:0853332672\"><span class=\"sw-hulp-teken\" style=\"background:#10b981\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/></svg></span><span><span class=\"sw-hulp-waarde\">(0)85 333 26 72</span><span class=\"sw-hulp-sub\">{{ 'sw.home.hulp.uren' | t }}</span></span></a></div></div><div class=\"sw-hulp-onder\"><p class=\"sw-hulp-zelf\"><b>{{ 'sw.home.hulp.account' | t }}</b><a href=\"{{ sw_root }}/account\">{{ 'sw.home.hulp.traceren' | t }}</a><span class=\"sw-hulp-punt\">&middot;</span><a href=\"{{ sw_root }}/account\">{{ 'sw.home.hulp.adres' | t }}</a><span class=\"sw-hulp-punt\">&middot;</span><a href=\"{{ sw_root }}/account\">{{ 'sw.home.hulp.retour' | t }}</a></p><div class=\"sw-hulp-betaal\"><span>{{ 'sw.home.hulp.betalen' | t }}</span><div class=\"sw-hulp-logos\"><div><img src=\"https://cdn.shopify.com/s/files/1/0988/8720/5208/files/sw-betaal-ideal.png?width=240\" alt=\"iDEAL\" width=\"120\" height=\"106\" loading=\"lazy\"></div><div><img src=\"https://cdn.shopify.com/s/files/1/0988/8720/5208/files/sw-betaal-visa.png?width=240\" alt=\"Visa\" width=\"120\" height=\"68\" loading=\"lazy\"></div><div><img src=\"https://cdn.shopify.com/s/files/1/0988/8720/5208/files/sw-betaal-mastercard.png?width=240\" alt=\"Maste