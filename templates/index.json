        "custom_liquid": "{%- assign sw_root = routes.root_url | append: '/' | replace: '//', '/' | remove_last: '/' -%}<section style=\"background:#061f40;padding:3rem 0\"><div style=\"max-width:48rem;margin:0 auto;padding:0 1.5rem;text-align:center\"><div style=\"display:inline-flex;align-items:center;gap:0.5rem;background:rgba(59,130,246,0.2);color:#93c5fd;font-size:0.75rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:9999px;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/><polyline points=\"22,6 12,13 2,6\"/></svg>{{ 'sw.home.nieuwsbrief.label' | t }}</div><h2 style=\"font-size:1.5rem;font-weight:800;color:#fff;margin:0 0 0.5rem\">{{ 'sw.home.nieuwsbrief.kop_html' | t }}</h2><p style=\"color:#9ca3af;font-size:0.875rem;margin:0 0 1.5rem\">{{ 'sw.home.nieuwsbrief.tekst' | t }}</p>{% form 'customer' %}{% if form.posted_successfully? %}<div style=\"display:inline-flex;align-items:center;gap:0.5rem;background:rgba(74,222,128,0.2);color:#4ade80;font-weight:600;padding:0.75rem 1.5rem;border-radius:0.75rem;font-size:0.875rem\">{{ 'sw.home.nieuwsbrief.gelukt' | t }}</div>{% else %}<div style=\"display:flex;gap:0.75rem;max-width:28rem;margin:0 auto;flex-wrap:wrap;justify-content:center\"><style>#swNlEmail::placeholder{color:rgba(255,255,255,0.55)}</style><input type=\"hidden\" name=\"contact[accepts_marketing]\" value=\"true\"><input id=\"swNlEmail\" type=\"email\" name=\"contact[email]\" required placeholder=\"{{ 'sw.home.nieuwsbrief.plaats' | t }}\" style=\"flex:1;min-width:180px;padding:0.75rem 1rem;border-radius:0.75rem;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:#fff;font-size:0.875rem;outline:none\"><button type=\"submit\" style=\"display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.25rem;border-radius:0.75rem;background:#0F6FE3;color:#fff;font-weight:600;font-size:0.875rem;border:none;cursor:pointer;white-space:nowrap\">{{ 'sw.home.nieuwsbrief.knop' | t }} <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg></button></div>{% endif %}{% endform %}</div></section>",
