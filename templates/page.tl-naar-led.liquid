<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Een TL-buis vervangen door een LED-TL buis",
  "description": "De oude buis eruit, het voorschakelapparaat uit het armatuur en de LED-buis op netspanning aansluiten. Geldt voor de LED-TL buizen die wij voeren: die werken alle vier direct op netspanning.",
  "url": "https://spotwereld.nl/pages/tl-naar-led",
  "totalTime": "PT20M",
  "tool": [
    { "@type": "HowToTool", "name": "Spanningszoeker" },
    { "@type": "HowToTool", "name": "Schroevendraaier" }
  ],
  "supply": [
    { "@type": "HowToSupply", "name": "LED-TL buis in de juiste lengte" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Groep uit en controleren",
      "text": "Schakel de groep uit in de meterkast en controleer met een spanningszoeker dat er geen spanning meer op het armatuur staat."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "De oude buis eruit",
      "text": "Draai de buis een kwartslag tot de pennen door de sleuf van de fitting kunnen en trek hem er recht uit. Ondersteun hem aan beide kanten."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Voorschakelapparaat eruit",
      "text": "Haal het voorschakelapparaat en de starterhouder uit het circuit en sluit de fase en de nul rechtstreeks op de fittingen aan. Onze LED-buizen werken op netspanning, dus de spoel mag er niet tussen blijven zitten."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "De LED-buis plaatsen",
      "text": "Schuif de pennen door de sleuven en draai de buis een kwartslag vast. Let bij een eenzijdig aangesloten buis op de gemarkeerde kant."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Stroom aan en controleren",
      "text": "Zet de groep terug. De buis hoort direct op vol licht te branden, zonder aanloop of geknipper."
    }
  ]
}
