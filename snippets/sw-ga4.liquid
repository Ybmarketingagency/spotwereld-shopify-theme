{%- comment -%}
  Google Analytics 4 - Spotwereld

  STAAT UIT. Vul hieronder het measurement ID (G-XXXXXXXXXX) in van de GA4-property
  van Spotwereld, dan gaat alles hieronder meteen draaien.

  Waarom leeg: er is nog GEEN GA4-property voor Spotwereld. In de Google-accounts die
  in deze browser zijn ingelogd staan alleen TechAzura-properties (techazura.nl,
  G-51H8EG3E88). Daar mag het verkeer van Spotwereld niet in terechtkomen. De
  Google-koppeling van de winkel loopt via spotwereldbv@gmail.com; daar hoort de
  property te komen.

  Wat hier gebeurt zodra het ID is ingevuld:
  - Consent Mode v2 staat standaard op denied en wordt bijgewerkt via Shopify's
    Customer Privacy API, zodat een cookiebanner later gewoon werkt zonder deze code
    aan te raken.
  - page_view gaat automatisch mee met de config-call.
  - view_item op productpagina's en view_item_list op collectiepagina's, zodat je in GA4
    ziet welke landingspagina welk product laat zien.
  - begin_checkout wordt vanuit sw-gegevens.liquid afgevuurd (window.swGA4.beginCheckout).
  - purchase komt NIET hiervandaan: dat gebeurt op de Shopify-bedankpagina en loopt via
    de custom pixel in Instellingen -> Klantgebeurtenissen.
{%- endcomment -%}

{%- liquid
  assign sw_ga4_id = ''
-%}
{%- if sw_ga4_id != blank and request.design_mode == false -%}
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ sw_ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });

    gtag('js', new Date());
    gtag('config', '{{ sw_ga4_id }}', { send_page_view: true });

    (function () {
      function toestemming() {
        var p = window.Shopify && window.Shopify.customerPrivacy;
        if (!p) return;
        gtag('consent', 'update', {
          analytics_storage: p.analyticsProcessingAllowed() ? 'granted' : 'denied',
          ad_storage: p.marketingAllowed() ? 'granted' : 'denied',
          ad_user_data: p.marketingAllowed() ? 'granted' : 'denied',
          ad_personalization: p.marketingAllowed() ? 'granted' : 'denied'
        });
      }
      document.addEventListener('visitorConsentCollected', toestemming);
      if (window.Shopify && window.Shopify.loadFeatures) {
        window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], toestemming);
      } else {
        toestemming();
      }
    })();

    window.swGA4 = {
      beginCheckout: function (waarde, artikelen) {
        gtag('event', 'begin_checkout', {
          currency: '{{ cart.currency.iso_code | default: "EUR" }}',
          value: waarde,
          items: artikelen || []
        });
      }
    };

    {%- if request.page_type == 'product' and product != blank -%}
      gtag('event', 'view_item', {
        currency: '{{ cart.currency.iso_code | default: "EUR" }}',
        value: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
        items: [{
          item_id: {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
          item_name: {{ product.title | json }},
          item_brand: {{ product.vendor | json }},
          item_category: {{ product.type | json }},
          price: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
          quantity: 1
        }]
      });
    {%- elsif request.page_type == 'collection' and collection != blank -%}
      gtag('event', 'view_item_list', {
        item_list_id: {{ collection.handle | json }},
        item_list_name: {{ collection.title | json }},
        items: [
          {%- for p in collection.products limit: 12 -%}
            {
              item_id: {{ p.selected_or_first_available_variant.sku | default: p.id | json }},
              item_name: {{ p.title | json }},
              item_category: {{ p.type | json }},
              price: {{ p.price | divided_by: 100.0 }},
              index: {{ forloop.index0 }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      });
    {%- endif -%}
  </script>
{%- endif -%}
