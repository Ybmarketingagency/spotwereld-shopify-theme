{%- comment -%} JSON-LD BreadcrumbList op collection en product pages {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.origin }}{{ routes.root_url }}"},
    {"@type": "ListItem", "position": 2, "name": "{{ collection.title | escape_once }}", "item": "{{ request.origin }}{{ collection.url }}"}
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
{%- comment -%}
  De variabele collection is alleen gevuld als de bezoeker via /collections/x/products/y
  binnenkomt. Google indexeert de canonieke /products/y en zag daar dus maar twee niveaus.
  Valt nu terug op de eerste echte categorie van het product, zodat het kruimelpad ook in
  de zoekresultaten compleet is. Alle producten en de startpagina-collectie slaan we over:
  die zeggen niets over waar het artikel thuishoort.
{%- endcomment -%}
{%- liquid
  assign sw_kruim = collection
  if sw_kruim == blank
    for sw_c in product.collections
      unless sw_c.handle == 'alle-producten' or sw_c.handle == 'frontpage'
        assign sw_kruim = sw_c
        break
      endunless
    endfor
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.origin }}{{ routes.root_url }}"},
    {%- if sw_kruim != blank -%}
    {"@type": "ListItem", "position": 2, "name": "{{ sw_kruim.title | escape_once }}", "item": "{{ request.origin }}{{ sw_kruim.url }}"},
    {"@type": "ListItem", "position": 3, "name": "{{ product.title | escape_once }}", "item": "{{ request.origin }}{{ product.url }}"}
    {%- else -%}
    {"@type": "ListItem", "position": 2, "name": "{{ product.title | escape_once }}", "item": "{{ request.origin }}{{ product.url }}"}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} BreadcrumbList op blogartikelen {%- endcomment -%}
{%- if request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.origin }}{{ routes.root_url }}"},
    {"@type": "ListItem", "position": 2, "name": "{{ blog.title | escape_once }}", "item": "{{ request.origin }}{{ blog.url }}"},
    {"@type": "ListItem", "position": 3, "name": "{{ article.title | escape_once }}", "item": "{{ request.origin }}{{ article.url }}"}
  ]
}
</script>
{%- endif -%}

{%- comment -%} BreadcrumbList op losse pages (gidsen, klantenservice, over ons) {%- endcomment -%}
{%- if request.page_type == 'page' -%}
