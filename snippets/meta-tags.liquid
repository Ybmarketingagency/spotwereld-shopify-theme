{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content="#061f40"
>

{%- liquid
  assign sw_kopen = 'sw.collectie.titel_kopen' | t
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  # Shopify leidt page_description zelf af uit de collectie- of productbeschrijving en
  # escapet daarbij een & die daar al als &amp; staat, zodat er &amp;amp; uitkomt. In de
  # meta description van de wandlampen las Google daardoor "Up &amp; down". Escape_once
  # helpt hier niet, want de invoer is al dubbel geescaped; die draaien we hier terug.
  assign og_description = og_description | replace: '&amp;amp;', '&amp;'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape_once }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape_once }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape_once }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape_once }}"
>

{%- comment -%}
  Spotwereld SEO: de SEO-velden uit Shopify gaan voor.
  Stond er niets ingevuld, dan bouwt het thema zelf een titel en omschrijving op.
  Voor 19-08-2026 werden die velden genegeerd, waardoor elke omschrijving een
  midden in een woord afgekapte productbeschrijving was.
{%- endcomment -%}
{%- comment -%}
  Bij een collectie zonder beschrijving pakken we dezelfde ingebouwde categorietekst die
  sw-collection-seo.liquid onder de grid zet, zodat de vijf collecties niet allemaal
  dezelfde sjabloonomschrijving krijgen.
{%- endcomment -%}
{%- capture sw_coll_terugval -%}
  {%- if request.page_type == 'collection' -%}{%- render 'sw-collectietekst', collection: collection -%}{%- endif -%}
{%- endcapture -%}
{%- liquid
  assign sw_brand = 'Spotwereld'
  assign sw_tagline = 'Premium LED Verlichting'

  # wat de winkelier zelf heeft ingevuld onder Vermelding in zoekmachines
  assign sw_seo_title = ''
  assign sw_seo_desc = ''
  if request.page_type == 'product'
    assign sw_seo_title = product.metafields.global.title_tag
    assign sw_seo_desc = product.metafields.global.description_tag
  elsif request.page_type == 'collection'
    assign sw_seo_title = collection.metafields.global.title_tag
    assign sw_seo_desc = collection.metafields.global.description_tag
  elsif request.page_type == 'page'
    assign sw_seo_title = page.metafields.global.title_tag
    assign sw_seo_desc = page.metafields.global.description_tag
  elsif request.page_type == 'article'
    assign sw_seo_title = article.metafields.global.title_tag
    assign sw_seo_desc = article.metafields.global.description_tag
  endif

  # Terugval: zelf opbouwen. truncate op tekens en niet truncatewords, want 24 lange
  # woorden werden zo 186 tekens en Google toont er ongeveer 155.
  if request.page_type == 'index'
    assign sw_title = 'sw.seo.home_titel' | t | append: ' | ' | append: sw_brand
    assign sw_desc = 'sw.seo.home_desc' | t
  elsif request.page_type == 'product'
    assign sw_title = product.title | append: ' ' | append: sw_kopen | append: ' | ' | append: sw_brand
    if product.description != blank
      assign sw_desc = product.description | replace: '2 jaar garantie', '5 jaar garantie' | replace: '2 Jaar garantie', '5 Jaar garantie' | replace: '2 year warranty', '5 year warranty' | replace: '2 Year warranty', '5 Year warranty' | replace: '2 years warranty', '5 years warranty' | replace: '<td>2 jaar</td>', '<td>5 jaar</td>' | replace: '<td>2 Jaar</td>', '<td>5 Jaar</td>' | strip_html | truncate: 155
    else
      assign sw_desc = 'sw.seo.product_desc' | t: titel: product.title
    endif
  elsif request.page_type == 'collection'
    # De formule "X kopen - LED X" werkt voor Inbouwspots en Wandlampen, maar levert bij
    # de restcategorieen onzin op ("Accessoires kopen - LED Accessoires"). Daar dus een
    # eigen titel. Een SEO-titel die in de admin is ingevuld wint hier nog steeds van.
    case collection.handle
      when 'accessoires'
        assign sw_title = 'sw.seo.accessoires_titel' | t | append: ' | ' | append: sw_brand
      when 'frontpage'
        assign sw_title = 'sw.collectie.titel_alles' | t | append: ' | ' | append: sw_brand
      when 'alle-producten'
        assign sw_title = 'sw.collectie.titel_alles' | t | append: ' | ' | append: sw_brand
      when 'all'
        assign sw_title = 'sw.collectie.titel_alles' | t | append: ' | ' | append: sw_brand
      else
        assign sw_coll_kop = 'sw.collectie.titel_patroon' | t: titel: collection.title
        assign sw_title = sw_coll_kop | append: ' | ' | append: sw_brand
    endcase
    if collection.description != blank
      assign sw_desc = collection.description | strip_html | truncate: 155
    elsif sw_coll_terugval != blank
      assign sw_desc = sw_coll_terugval | strip_html | strip | truncate: 155
    else
      assign sw_desc = 'sw.seo.collectie_desc' | t: titel: collection.title
    endif
  elsif request.page_type == 'article'
    # Het woord Blog erachter kostte 5 tekens en zei niets; dat is eruit. Past de titel
    # met merknaam nog steeds niet binnen de 60 tekens die Google toont, dan valt hij
    # terug op de kale artikeltitel. Beter de hele vraag laten zien dan de merknaam
    # halverwege afgekapt zien staan; Google zet er zelf al vaak de sitenaam bij.
    assign sw_kop = article.title | append: ' | ' | append: sw_brand
    if sw_kop.size > 60
      assign sw_title = article.title
    else
      assign sw_title = sw_kop
    endif
    assign sw_desc = article.excerpt_or_content | strip_html | truncate: 155
  elsif request.page_type == 'page'
    # Paginatitels als "Contact | Spotwereld" zijn met 20 tekens te mager voor de ruimte
    # die Google geeft, en vier paginas deelden dezelfde terugval-omschrijving. Deze
    # handles krijgen daarom een eigen titel en omschrijving uit de taalbestanden, zodat
    # ze meteen in beide talen kloppen. Een in de admin ingevulde SEO-titel wint hier
    # nog steeds van, want die wordt hieronder pas toegepast.
    case page.handle
      when 'contact'
        assign sw_paginakop = 'sw.seo.contact_titel' | t
        assign sw_paginadesc = 'sw.seo.contact_desc' | t
      when 'verzending-retouren'
        assign sw_paginakop = 'sw.seo.verzending_titel' | t
        assign sw_paginadesc = 'sw.seo.verzending_desc' | t
      when 'partner-worden'
        assign sw_paginakop = 'sw.seo.partner_titel' | t
        assign sw_paginadesc = 'sw.seo.partner_desc' | t
      when 'over-ons'
        assign sw_paginakop = 'sw.seo.overons_titel' | t
        assign sw_paginadesc = 'sw.seo.overons_desc' | t
      when 'garantie'
        assign sw_paginakop = 'sw.seo.garantie_titel' | t
        assign sw_paginadesc = 'sw.seo.garantie_desc' | t
      when 'algemene-voorwaarden'
        assign sw_paginadesc = 'sw.seo.voorwaarden_desc' | t
      when 'privacyverklaring'
        assign sw_paginadesc = 'sw.seo.privacy_desc' | t
      when 'gegevens'
        assign sw_paginakop = 'sw.seo.gegevens_titel' | t
    endcase
    if sw_paginakop != blank
      assign sw_title = sw_paginakop | append: ' | ' | append: sw_brand
    else
      assign sw_title = page.title | append: ' | ' | append: sw_brand
    endif
    if sw_paginadesc != blank
      assign sw_desc = sw_paginadesc
    elsif page.content != blank
      assign sw_desc = page.content | strip_html | truncate: 155
    else
      assign sw_desc = 'sw.seo.pagina_desc' | t
    endif
  else
    assign sw_title = page_title | append: ' | ' | append: sw_brand
    assign sw_desc = page_description | default: shop.description | default: sw_tagline
  endif

  # Het ingevulde veld wint van de terugval. De metavelden hierboven zeggen alleen OF de
  # winkelier iets heeft ingevuld; de waarde halen we uit page_title en page_description,
  # want die geven op /en/ de vertaalde tekst terug en het metaveld niet.
  if sw_seo_title != blank
    assign sw_title = page_title
  endif
  if sw_seo_desc != blank
    assign sw_desc = page_description | replace: '&amp;amp;', '&amp;'
  endif
-%}

<title>
  {{ sw_title }}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'sw.seo.pagina' | t: nummer: current_page }}{% endif -%}
</title>

<meta name="description" content="{{ sw_desc | strip_html | escape_once }}">

{%- comment -%}
  Spotwereld: canonical.
  /collections/alle-producten en /collections/all tonen exact dezelfde producten. Google
  ziet dat als dubbele inhoud en moet zelf raden welke van de twee de echte is. De
  handmatige collectie "Alle producten" stuurt de volgorde en is dus de baas; /all wijst
  naar haar. Zie ook [[project_spotwereld_alle_producten_volgorde]].
{%- endcomment -%}
{%- liquid
  assign sw_canonical = canonical_url
  if request.page_type == 'collection' and collection.handle == 'all'
    assign sw_canonical = request.origin | append: '/collections/alle-producten'
  endif
-%}
<link rel="canonical" href="{{ sw_canonical }}">

{%- comment -%}
  Spotwereld: extra SEO meta tags.

  Twee pagina's horen niet in Google:
  - /pages/gegevens is stap 2 van onze eigen checkout, een leeg formulier zonder H1.
  - /collections/frontpage is de automatische Shopify-startcollectie, met als titel
    "Home page kopen - LED Home page" en H1 "Home page". Die staat wel in de sitemap
    maar nergens in de navigatie.
{%- endcomment -%}
{%- liquid
  assign sw_noindex = false
  if request.page_type == 'page' and page.handle == 'gegevens'
    assign sw_noindex = true
  endif
  # de bedankpagina is alleen zinvol na een verstuurd formulier
  if request.page_type == 'page' and page.handle == 'bedankt'
    assign sw_noindex = true
  endif
  if request.page_type == 'collection' and collection.handle == 'frontpage'
    assign sw_noindex = true
  endif
-%}
{%- if sw_noindex -%}
  <meta name="robots" content="noindex, follow">
{%- else -%}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif -%}
<meta name="author" content="Spotwereld">
<meta name="format-detection" content="telephone=no">

{%- comment -%} Favicon - hardcoded blauwe O-spotlight, overschrijft Shopify settings favicon {%- endcomment -%}
<link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
<link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
<link rel="icon" type="image/png" sizes="16x16" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
<link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
<link rel="shortcut icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png">
<script>
(function(){
  function removeOldFavicons(){
    document.querySelectorAll('link[rel*="icon"]').forEach(function(el){
      if(el.href.indexOf('wwoqIM6') === -1){
        el.parentNode.removeChild(el);
      }
    });
    // Force browser favicon refresh
    var fresh = document.createElement('link');
    fresh.rel = 'icon';
    fresh.type = 'image/png';
    fresh.href = 'https://cdn.shopify.com/s/files/1/0988/8720/5208/files/wwoqIM6.png?v=' + Date.now();
    document.head.appendChild(fresh);
  }
  removeOldFavicons();
  document.addEventListener('DOMContentLoaded', removeOldFavicons);
})();
</script>

