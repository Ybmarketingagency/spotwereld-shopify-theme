{%- comment -%} Override Open Graph title/description met onze SEO versie {%- endcomment -%}
<meta property="og:title" content="{{ sw_title | escape_once }}" data-sw-override>
<meta property="og:description" content="{{ sw_desc | strip_html | escape_once }}" data-sw-override>
<meta name="twitter:title" content="{{ sw_title | escape_once }}" data-sw-override>
<meta name="twitter:description" content="{{ sw_desc | strip_html | escape_once }}" data-sw-override>

{%- comment -%} Card image override mechanisme (uitgeschakeld; images serverside correct) {%- endcomment -%}
<style>
/* Unify card titles: collection page (product-card H3/text-block) matches homepage (sw-pp-card .sw-pp-name) */
.sw-pp-name,
product-card h3,
product-card h4,
product-card .h4,
product-card .h3,
product-card [class*="product_title"],
product-card [class*="product-card__title"],
product-card .product-card__title,
product-card .product-card__title a,
product-card product-title,
product-card product-title a,
.product-card h3,
.product-card h4,
.product-card .h4{
  font-weight:600 !important;
  color:#1e293b !important;
  font-size:.85rem !important;
  line-height:1.35 !important;
  font-family:inherit !important;
  text-decoration:none !important;
  letter-spacing:normal !important;
}
/* Ook de inline tekst-block container die Horizon gebruikt */
product-card [class*="product_title"] *,
product-card .text-block[class*="product_title"]{
  color:#1e293b !important;
  font-weight:600 !important;
}
/* Custom + Shopify native facet chevron */
.facets__item .facets__summary,details.facets__item summary{display:flex !important;justify-content:space-between;align-items:center;cursor:pointer;list-style:none}
.facets__item .facets__summary::-webkit-details-marker,details.facets__item summary::-webkit-details-marker{display:none}
.facets__item .facets__icon,details.facets__item summary .facets__icon{display:inline-flex;align-items:center}
.facets__item .facets__icon svg,details.facets__item summary .facets__icon svg{transition:transform .2s;color:#061f40;width:14px;height:14px}
details.facets__item[open] .facets__icon svg{transform:rotate(180deg)}
/* Inject chevron if not present (CSS fallback) */
.facets__item .facets__icon:empty::after{content:'';display:inline-block;width:8px;height:8px;border-right:2px solid #061f40;border-bottom:2px solid #061f40;transform:rotate(45deg);transition:transform .2s;margin-bottom:3px}
details.facets__item[open] .facets__icon:empty::after{transform:rotate(-135deg);margin-bottom:-3px}
/* Force checkbox visibility — gebruik ALLEEN icon-checkmark (custom), verberg de native input visueel */
.facets__item .checkbox{display:flex !important;align-items:center !important;gap:.5rem !important;position:relative}
.facets__item .checkbox__input{position:absolute !important;opacity:0 !important;width:18px !important;height:18px !important;margin:0 !important;left:0 !important;top:50% !important;transform:translateY(-50%) !important;cursor:pointer !important;z-index:1}
.facets__item .icon-checkmark{display:inline-block !important;width:18px !important;height:18px !important;border:1.5px solid #cbd5e1 !important;border-radius:4px !important;flex-shrink:0 !important;background:#fff !important;position:relative}
.facets__item .checkbox__input:checked + .checkbox__label .icon-checkmark,.facets__item .checkbox__input:checked ~ .checkbox__label .icon-checkmark{background:#061f40 !important;border-color:#061f40 !important}
.facets__item .checkbox__input:checked + .checkbox__label .icon-checkmark::after,.facets__item .checkbox__input:checked ~ .checkbox__label .icon-checkmark::after{content:'';position:absolute;left:5px;top:1px;width:5px;height:10px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.facets__item .swatch{display:none !important}
/* Hier stond een FOUC-fix die de H1 op productpagina's op opacity:0 zette tot JS de class
   sw-title-ready toevoegde (met een 1.2s keyframe-fallback). Die bestond om het flikkeren
   te maskeren van de titel-rewriter, en die rewriter is verwijderd — hij werkte op een
   lege lookup-tabel. De H1 is op productpagina's doorgaans het LCP-element, dus dit
   vertraagde de gemeten Largest Contentful Paint zonder dat het nog iets verborg. */
/* (LAOM FOUC-regels verwijderd: product images zijn nu correct serverside) */
/* Dimbaar facet — override pill/button styling, force standard checkbox layout */
.facets__item button,.facets__item .button,.facets__item [class*="filter-pill"]{all:unset !important}
.facets__item .facets__inputs-list-item,.facets__item li{background:transparent !important;border:0 !important;padding:.2rem 0 !important;list-style:none !important}
.facets__item .facets__inputs-list-item:not([style*="display:none"]):not([data-sw-hidden]),.facets__item li:not([style*="display:none"]):not([data-sw-hidden]){display:block}
.facets__item [data-sw-hidden]{display:none !important}
.facets__item .checkbox__label{display:flex !important;align-items:center !important;gap:.5rem !important;background:transparent !important;color:#1e293b !important;font-weight:500 !important;padding:0 !important;border:0 !important;border-radius:0 !important;cursor:pointer}
/* ===== WELKOM 5% KORTING POPUP ===== */
.sw-popup-overlay{position:fixed;inset:0;background:rgba(6,31,64,0.55);z-index:99998;display:none;align-items:center;justify-content:center;padding:1rem;animation:swPopupFade .25s ease}
.sw-popup-overlay.sw-active{display:flex}
@keyframes swPopupFade{from{opacity:0}to{opacity:1}}
.sw-popup{background:#fff;border-radius:16px;max-width:440px;width:100%;padding:2rem 1.75rem;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.25);animation:swPopupSlide .35s cubic-bezier(.16,1,.3,1);text-align:center;font-family:inherit}
@keyframes swPopupSlide{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
.sw-popup-close{position:absolute;top:.5rem;right:.5rem;background:#fff;border:0;font-size:1.6rem;cursor:pointer !important;color:#475569;width:36px;height:36px;border-radius:50%;display:flex !important;align-items:center;justify-content:center;transition:all .15s;line-height:1;z-index:100;pointer-events:auto !important;padding:0;font-family:inherit;font-weight:400;user-select:none;-webkit-appearance:none;appearance:none}
.sw-popup-close:hover{background:#f1f5f9;color:#061f40;transform:scale(1.05)}
.sw-popup-close:focus{outline:2px solid #0F6FE3;outline-offset:2px}
.sw-popup-close *{pointer-events:none}
.sw-popup-badge{display:inline-block;background:linear-gradient(135deg,#FF6B35,#F7931E);color:#fff;font-weight:800;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .75rem;border-radius:999px;margin-bottom:.75rem}
.sw-popup-discount{font-size:3.5rem;font-weight:900;color:#061f40;margin:.25rem 0;letter-spacing:-.03em;line-height:1;background:linear-gradient(135deg,#083D7D,#0F6FE3);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.sw-popup h2{font-size:1.4rem;font-weight:900;color:#061f40;margin:0 0 .5rem;letter-spacing:-.02em}
.sw-popup p{color:#475569;font-size:.92rem;line-height:1.5;margin:0 0 1.25rem}
.sw-popup-form{display:flex;flex-direction:column;gap:.6rem}
.sw-popup-input{width:100%;padding:.85rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.95rem;outline:none;transition:border-color .15s;box-sizing:border-box;font-family:inherit}
.sw-popup-input:focus{border-color:#0F6FE3}
.sw-popup-btn{background:linear-gradient(135deg,#083D7D,#0F6FE3);color:#fff;border:0;border-radius:8px;padding:.95rem 1rem;font-weight:700;font-size:.95rem;cursor:pointer;transition:all .15s;font-family:inherit;letter-spacing:.01em}
.sw-popup-btn:hover{background:linear-gradient(135deg,#062d5c,#0a5abf);transform:translateY(-1px);box-shadow:0 6px 16px rgba(8,61,125,.25)}
.sw-popup-btn:disabled{opacity:.6;cursor:wait}
.sw-popup-tiny{font-size:.7rem;color:#94a3b8;margin-top:.5rem !important}
.sw-popup-success{display:none}
.sw-popup-success.sw-show{display:block}
.sw-popup-form-wrap.sw-hide{display:none}
.sw-popup-code{display:inline-flex;align-items:center;gap:.6rem;background:#f1f5f9;border:2px dashed #0F6FE3;border-radius:10px;padding:.85rem 1.1rem;margin:.75rem 0 1rem;font-family:'Courier New',monospace;font-size:1.4rem;font-weight:900;color:#061f40;letter-spacing:.1em}
.sw-popup-copy{background:#061f40;color:#fff;border:0;padding:.4rem .75rem;border-radius:6px;font-size:.75rem;font-weight:600;cursor:pointer;letter-spacing:.05em}
.sw-popup-copy:hover{background:#0F6FE3}
.sw-popup-copy.sw-copied{background:#16a34a}
/* Persistent bar onderaan (na popup) als ze code hebben gekregen */
.sw-discount-bar{position:fixed;bottom:0;left:0;right:0;background:linear-gradient(90deg,#083D7D,#0F6FE3);color:#fff;padding:.6rem 1rem;text-align:center;font-size:.85rem;font-weight:600;z-index:99997;display:none;align-items:center;justify-content:center;gap:.75rem;flex-wrap:wrap}
.sw-discount-bar.sw-show{display:flex}
.sw-discount-bar code{background:rgba(255,255,255,.18);padding:.2rem .55rem;border-radius:4px;font-family:'Courier New',monospace;letter-spacing:.1em;font-weight:700}
.sw-discount-bar button.close{background:none;border:0;color:#fff;cursor:pointer;font-size:1.1rem;opacity:.7;padding:0 .25rem}
.sw-discount-bar button.close:hover{opacity:1}
@media(max-width:480px){.sw-popup{padding:1.5rem 1.25rem}.sw-popup-discount{font-size:2.8rem}.sw-popup h2{font-size:1.15rem}}
</style>
{%- comment -%}
  Storefront-gedrag (checkout-redirect, eigen productfilters, kortingpopup) staat in
  assets/sw-storefront.js. Het stond hier inline in de <head> en blokkeerde daar de
  HTML-parser; als asset wordt het gecached in plaats van bij elke pagina opnieuw
  meegestuurd. defer = uitvoeren na het parsen, maar voor DOMContentLoaded.
{%- endcomment -%}
<script src="{{ 'sw-storefront.js' | asset_url }}" defer></script>

{%- comment -%} Preconnect voor performance {%- endcomment -%}
{%- comment -%}
  De preconnect naar imgur is weg: sinds 23-08-2026 staan alle afbeeldingen in Shopify Files.
  PageSpeed waarschuwde bovendien voor te veel preconnect-verbindingen; die moeten alleen
  naar de oorsprongen die er echt toe doen.
{%- endcomment -%}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
<link rel="dns-prefetch" href="https://cdn.shopify.com">

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | replace: '&amp;amp;', '&amp;' | escape_once }}"
    data-sw-fallback
  >
{% endif %}
