{%- comment -%}
  Kop van de winkel (sinds 22-09-2026): bovenste rij logo links, brede zoekbalk in het
  midden, account en winkelwagen rechts met het woord eronder; daaronder de rij met alle
  pagina's. De rijverdeling zelf staat in sections/header-group.json (menu_row bottom,
  search_position center) en de zoekbalk in snippets/search.liquid. Hier alleen de
  opmaak van account en winkelwagen: Horizon toont óf een icoon óf tekst, wij willen
  allebei, icoon boven, woord eronder.
{%- endcomment -%}
<style>
  @media screen and (min-width: 750px) {
    .header__row--top header-actions {
      gap: 0.25rem;
    }
    /* Account (niet ingelogd): eigen knop uit header-actions.liquid */
    .header__row--top #sw-acct-btn {
      flex-direction: column;
      gap: 4px;
      padding: 0.25rem 0.6rem;
    }
    .header__row--top #sw-acct-btn .account-button__text.hidden {
      display: block !important;
      font-size: 0.6875rem;
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0.01em;
      order: 2;
    }
    .header__row--top #sw-acct-btn > span:not(.account-button__text) {
      order: 1;
    }
    .header__row--top #sw-acct-btn .account-button__icon {
      width: 20px;
      height: 22px;
    }
    /* Winkelwagen */
    .header__row--top .header-actions__cart-icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 0.25rem 0.6rem;
    }
    .header__row--top .header-actions__cart-icon > span.hidden {
      display: block !important;
      font-size: 0.6875rem;
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0.01em;
      order: 2;
    }
    .header__row--top .header-actions__cart-icon > .svg-wrapper {
      order: 1;
    }
    .header__row--top .header-actions__cart-icon .svg-wrapper svg {
      width: 22px;
      height: 22px;
    }
    /* Het icoon van de winkelwagen zat in een vak van 44 px en hing daardoor lager dan het
       account-icoon. Zelfde maat als het account-icoon, dan staan ze op één hoogte. */
    .header__row--top .header-actions__cart-icon > .svg-wrapper {
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* Het aantal-bolletje hoort rechtsboven op het icoon, niet rechtsboven in het hele blok;
       en de uitsparing die Horizon in het icoon maskert laten we weg, die gaf een gat op de
       verkeerde plek. */
    .header__row--top .header-actions__cart-icon {
      --cart-bubble-size: 16px;
    }
    .header__row--top .header-actions__cart-icon .cart-bubble {
      top: 0;
      right: auto;
      left: calc(50% + 4px);
    }
    .header__row--top .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
      mask: none;
    }
    /* De streep tussen de bovenste rij en de menurij (divider_width in header-group.json) */
    .header__row--top {
      --color-border: rgba(255, 255, 255, 0.18);
    }
    /* Menurij: iets strakker en gecentreerd */
    .header__row--bottom .header__columns {
      padding-block: 0;
    }
  }
</style>
