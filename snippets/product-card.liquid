{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}
    {%- unless onboarding -%}
      {%- liquid
        # Kenmerkbadges. Afgeleid uit de metavelden, dus er valt niets handmatig te taggen:
        # zet je het metaveld goed, dan klopt de badge vanzelf. Maximaal twee per kaart,
        # anders wordt het een lappendeken. Volgorde = zeldzaamste eerst.
        assign lichtkleur = product.metafields.custom.lichtkleur.value
        assign ip_filter = product.metafields.custom.ip_waarde_filter.value

        assign sw_badges = ''
        if lichtkleur contains 'Dim2Warm'
          assign sw_badges = sw_badges | append: 'Dim2Warm|'
        endif
        if lichtkleur contains 'Instelbaar'
          assign sw_badges = sw_badges | append: 'CCT-switch|'
        endif
        if ip_filter contains 'IP65'
          assign sw_badges = sw_badges | append: 'IP65|'
        endif
        # Dimbaar achteraan: minst zeldzaam. Niet naast Dim2Warm, want die zegt het al.
        assign sw_dimbaar = product.metafields.custom.dimbaar.value
        assign sw_heeft_d2w = false
        if sw_badges contains 'Dim2Warm'
          assign sw_heeft_d2w = true
        endif
        unless sw_heeft_d2w
          assign sw_dimbaar_start = sw_dimbaar | slice: 0, 2
          if sw_dimbaar_start == 'Ja'
            assign sw_badges = sw_badges | append: 'Dimbaar|'
          endif
        endunless
        assign sw_badge_list = sw_badges | split: '|'
      -%}
      {%- if sw_badge_list.size > 0 -%}
        <div class="sw-card-badges">
          {%- for badge in sw_badge_list limit: 3 -%}
            <span class="sw-card-badge{% if badge == 'Dim2Warm' %} sw-card-badge--fill{% endif %}">{{ badge }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if product.available -%}
        <span class="sw-card-stock">Op voorraad</span>
      {%- endif -%}
      <a href="{{ variant_to_link.url }}" class="sw-card-bekijk" tabindex="-1" aria-hidden="true">Bekijk Product <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
    {%- endunless -%}
  </div>
</product-card>

{% stylesheet %}
  product-card.product-card{position:relative;display:flex;flex-direction:column;height:100%}
  product-card.product-card .product-card__content{display:flex;flex-direction:column;height:100%}
  .product-card .product-card__title,.product-card product-title,.product-card .product-title{min-height:2.6em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .product-card .sw-card-bekijk{margin-top:auto !important}
  .product-card .sw-card-badges{position:absolute;top:.5rem;left:.5rem;z-index:5;display:flex;flex-direction:column;align-items:flex-start;gap:.25rem;pointer-events:none}
  .product-card .sw-card-badge{font-size:.65rem;font-weight:600;letter-spacing:.01em;line-height:1;color:#12181f;background:rgba(255,255,255,.95);border:1px solid #d7dce2;padding:.25rem .45rem;border-radius:4px;white-space:nowrap}
  .product-card .sw-card-badge--fill{color:#fff;background:#12181f;border-color:#12181f}
  .product-card .sw-card-stock{position:absolute;top:.5rem;right:.5rem;z-index:5;font-size:.65rem;font-weight:600;color:#16a34a;background:rgba(255,255,255,.95);padding:.18rem .45rem;border-radius:4px;display:inline-flex;align-items:center;gap:.25rem}
  .product-card .sw-card-stock::before{content:'';width:6px;height:6px;border-radius:50%;background:#16a34a;display:inline-block;margin-right:.25rem}
  .product-card .sw-card-bekijk{display:flex;align-items:center;justify-content:center;gap:.4rem;background:linear-gradient(135deg,#083D7D,#0F6FE3);color:#fff !important;border:none;border-radius:.5rem;padding:.65rem .75rem;font-weight:700;font-size:.82rem;cursor:pointer;width:100%;transition:all .15s;letter-spacing:.01em;margin-top:.5rem;text-decoration:none !important;line-height:1;box-sizing:border-box;position:relative;z-index:10;order:100}
  .product-card .sw-card-bekijk:hover{background:linear-gradient(135deg,#062d5c,#0a5abf);transform:translateY(-1px);box-shadow:0 4px 12px rgba(8,61,125,.2)}
  .product-card .sw-card-bekijk svg{flex-shrink:0;transition:transform .2s}
  .product-card .sw-card-bekijk:hover svg{transform:translateX(3px)}
  .product-card .quick-add{display:none !important}
  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
