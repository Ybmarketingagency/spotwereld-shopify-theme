{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  {%- if bar -%}
    {%- comment -%}
      Brede zoekbalk in de kop. Het is bewust geen echt formulier: een klik opent dezelfde
      zoekdialoog als het icoon, met suggesties terwijl je typt en de prefix-fix uit
      sw-zoek-prefix. Zo blijft er één zoekpad.
    {%- endcomment -%}
    <search-button class="search-action sw-zoekbalk{% if class != blank %} {{ class | strip }}{% endif %}">
      <button
        on:click="#search-modal/showDialog"
        class="button-unstyled sw-zoekbalk__knop"
        aria-label="{{ 'content.search_input_label' | t }}"
        aria-haspopup="dialog"
      >
        <span class="sw-zoekbalk__tekst">{%- if request.locale.iso_code == 'en' -%}Search products...{%- else -%}Zoek producten...{%- endif -%}</span>
        <span class="svg-wrapper sw-zoekbalk__icoon">{{ 'icon-search.svg' | inline_asset_content }}</span>
      </button>
    </search-button>
  {%- else -%}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
  {%- endif -%}
{% endunless %}

{% stylesheet %}
  /* Spotwereld: brede zoekbalk in de middenkolom van de kop */
  .sw-zoekbalk {
    width: 100%;
    max-width: 600px;
  }
  .sw-zoekbalk__knop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    height: 44px;
    padding: 0 0.9rem 0 1.1rem;
    border-radius: 10px;
    background: #ffffff;
    color: #6b7280;
    font-size: 0.9375rem;
    text-align: left;
    cursor: text;
    box-shadow: inset 0 0 0 1px rgba(20, 41, 87, 0.12);
  }
  .sw-zoekbalk__knop:hover,
  .sw-zoekbalk__knop:focus-visible {
    box-shadow: inset 0 0 0 2px #0f6fe3;
    outline: none;
  }
  .sw-zoekbalk__tekst {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sw-zoekbalk__icoon {
    flex: none;
    color: #142957;
    width: 20px;
    height: 20px;
  }
  .sw-zoekbalk__icoon svg {
    width: 20px;
    height: 20px;
  }
  /* de middenkolom mag meegroeien zodat de balk breed wordt */
  .header__columns:has(.header__column--center .sw-zoekbalk) {
    --header-center: minmax(0, 1fr);
  }
  .header__column--center:has(.sw-zoekbalk) {
    width: 100%;
  }

  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
